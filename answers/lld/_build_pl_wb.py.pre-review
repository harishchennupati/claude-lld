# move 7 (new): what the lock protects, and ten gates at once
m7n=_D+_card(30,20,540,150,"inside the lock: about 1.5 microseconds",["look up the plate in a map","walk the floors until one has a fitting spot (a few)","poll the head of one queue","set the spot's occupant; put the ticket in a map","take a snapshot of the counts"],acc=True)
m7n+=_ar("M570 95 H640",True)+_tx(605,85,"unlock","var(--acc)",10.5)
m7n+=_card(640,20,560,150,"outside the lock: milliseconds to seconds",["print the ticket, lift the barrier: ~2,000,000 us","the display board: it hears after unlock","the driver: seconds","the card payment at exit: ~500 ms, inside today (rung 1 of the ladder)"])
m7n+=_tx(615,205,"ten gates press at the same instant","var(--text)",12)
for k in range(10):
    x=30+k*118; m7n+=_bx(x,220,106,40,"gate %d"%(k+1),"waits %s us"%("0" if k==0 else "%.1f"%(k*1.5)),acc=(k==9))
m7n+=_tx(615,290,"the tenth gate waits 13.5 microseconds for the lock, then spends two seconds lifting its barrier arm: one by one is true, and nobody can tell","var(--muted)",11)
