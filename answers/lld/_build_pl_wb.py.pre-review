pf+=_tx(80,266,"query","var(--acc)",13)+_tx(150,266,"at any moment, without scanning the spots: is it full for a truck?  how many compact spots are free on floor 2?","var(--text)",12,"start")
pf+=_tx(80,296,"lost","var(--acc)",13)+_tx(150,296,"no ticket at the exit gate: the same order as unpark, with the daily cap as the fee","var(--text)",12,"start")
