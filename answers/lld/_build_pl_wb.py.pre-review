# move 10: patterns, named after the fact
cols=[("pattern",12),("born in",200),("the line in the code",290),("what it buys",830)]
rows=[[("Strategy","var(--text)"),("move 3",None),("interface PricingStrategy { double price(Ticket t); }  via configure()",None),("swap a rule without opening the lot",None)],
      [("Decorator","var(--text)"),("move 3",None),("WeekendSurgePricing(PricingStrategy base): base.price(t) x 1.5",None),("add to a rule instead of copying it",None)],
      [("Observer","var(--text)"),("move 4",None),("floor.publish(counts) after unlock; DisplayBoard implements the observer",None),("the board hears; the lot never knows what a screen is",None)],
      [("State","var(--text)"),("move 6",None),("enum TicketStatus + the exit order (peek, pay, then commit)",None),("an illegal move cannot happen",None)],
      [("Singleton","var(--text)"),("the edge",None),("ParkingLot.getInstance(); gates are HANDED the lot, they never call it",None),("one lot per process, nothing hidden",None)],
      [("Factory","var(--muted)"),("not yet",None),("arrive typed; earns a place when built from strings: Vehicle.of(\"CAR\", p)","var(--muted)"),("say 'not yet, and here is what would make me'","var(--muted)")],
      [("Builder, Template, Command","var(--muted)"),("never",None),("no move produced them",	"var(--muted)"),("a pattern without a move is decoration","var(--muted)")]]
m10=_D+_table(20,20,cols,rows,rowh=30,widths=1190)
m10+=_tx(615,275,"name a pattern only after the move that produced it; then every name has a one-sentence defence","var(--muted)",11)
MV[10]=_mv(1230,290,m10)

# move 11: SOLID as a check on the moves
cols=[("",12),("the rule, in plain words",50),("from",440),("the line that shows it",560)]
rows=[[("S","var(--acc)"),("one reason to change per class (each owns one state)",None),("move 2",None),("Spot: its occupant. Floor: its free queues. Lot: the flow and the lock",None)],
      [("O","var(--acc)"),("new behaviour is a new class, not an edited one",None),("move 3",None),("surge = one new class + one changed configure() line",None)],
      [("L","var(--acc)"),("any implementation drops in; nobody checks which",None),("move 3",None),("double fee = pricing.price(t);  never 'is it the surge one?'",None)],
      [("I","var(--acc)"),("small interfaces: one method each",None),("move 3",None),("PricingStrategy, SpotAssignmentStrategy, PaymentProcessor: one method",None)],
      [("D","var(--acc)"),("depend on interfaces; implementations are handed in",None),("moves 3, 9",None),("lot.setClock(() -> saturdayMs);  lot.unpark(plate, amount -> false)",None)]]
m11=_D+_table(20,20,cols,rows,rowh=34,widths=1190)
m11+=_tx(615,250,"SOLID is not a list to recite; it is the check that the moves did their job, one line each","var(--muted)",11)
MV[11]=_mv(1230,265,m11)

# move 12: any twist is one of five moves
m12=_D
tw=[("a new rule","nearest exit, a pass, a charging fee, a cap","a new class behind the existing interface + one configure line","move 3"),
    ("someone new wants to know","SMS, analytics, a board that must not fall behind","one more observer; the floor does not change","move 4"),
    ("a new step in a life","reserved, paying, towed","a new state + one row in the transition table","move 6"),
    ("a new invariant across spots","two adjacent spots for a truck; a held booking","both claims inside the SAME lock: all or nothing","move 4"),
    ("state that must outlive the process","persist it; many branches","the two maps behind a repository interface; the spot claim becomes","move 5 + this one")]
for k,(t,sub,fix,mv) in enumerate(tw):
    y=24+k*54; m12+=_bx(30,y,330,44,t,sub)+_ar("M360 %s H420"%(y+22),True)+_bx(420,y,660,44,fix,"UPDATE spot SET plate=? WHERE id=? AND plate IS NULL: the database's compare-and-set" if k==4 else "",acc=True)+_tx(1150,y+27,mv,"var(--muted)",11)
m12+=_tx(615,310,"for all five the services do not change; that is the test that the derivation was right","var(--muted)",11)
MV[12]=_mv(1230,325,m12)

# ---------- derivation moves text (from the old step 02, kept, plus 6-8)
MOVES=[
("Move 1: underline the nouns. Every noun with its own state becomes a class.","Reading the paragraph again: a <b>vehicle</b> enters a <b>gate</b>; a <b>floor</b> has <b>spots</b> of three sizes; I issue a <b>ticket</b>; I take <b>payment</b>; I answer <b>availability</b>. Vehicle has a plate and a type: a class. Spot has a size and whoever is in it: a class. Floor owns spots: a class. Ticket has a spot, a vehicle, two times and a status: a class. The lot holds all of it: a class. Gate has nothing of its own to remember, so it is a thin caller, not a model. Availability is a question I answer, so it is a method, not a class.",1),
("Move 2: for every verb, ask which class holds the state it touches. That class gets the method.","\"assign a vehicle to a spot\" changes the spot's occupant, so <code>spot.assign(v)</code>. \"find a free spot of a size\" reads the floor's free queues, so <code>floor.peekFree(size)</code>. \"park\" touches floors, tickets and the lock at once; only the lot sees all three, so <code>lot.park(v)</code>. When a verb's state is spread over two classes, it goes to the class that owns both. That is how small models and one orchestrator appear without planning them.",2),
("Move 3: every rule the interviewer can change mid-round goes behind an interface and is handed in.","Pricing will change (flat today, surge on weekends). Which spot to pick will change (smallest fit today, nearest exit tomorrow). How to pay will change (card, cash, UPI). Each becomes a one-method interface the lot is <i>given</i> in <code>configure()</code>, never builds itself. Hand the assignment rule the whole <code>Vehicle</code> and not just its type, and three later twists cost nothing: a monthly pass reads the plate, an electric car is a subclass, a disabled badge is a field. A rule nobody will change stays a plain method. This is where the patterns come from, not the other way round: a swappable rule behind an interface is <b>Strategy</b>; a new rule that wraps an old one (surge over flat) is <b>Decorator</b>; a floor that announces 'counts changed' to whoever subscribed, without knowing what a screen is, is <b>Observer</b>. I do them; I do not announce them.",3),
("Move 4: state that many callers change at the same time gets one owner and one lock.","Ten gates all change spot occupancy and the ticket map. Between \"I saw C1 free\" and \"I took C1\" another gate can take it; that gap is where two cars get one spot. So find, take and issue must be one step under one lock, in the class that owns both maps: the lot. And anything that only listens (the display board) is called after the lock is released, never inside it.",4),
("Move 5: for each collection, ask what question is asked of it, and pick the shape that answers in O(1).","\"next free spot of this size\": a queue per size, the head is the answer. Ask the second question too, because the interviewer will: <i>which</i> free spot of that size? That is the queue's ORDER, and it is a rule like any other, so it is handed to the floor: a plain deque means \"any of them\", a heap keyed by metres from the exit means \"the nearest\", and <code>peekFree</code> does not change. \"This ticket, by plate\": a map. \"Which floor is this ticket on\": store the floor on the ticket at entry so exit never searches. \"How many compact spots are free on floor two\": that floor's queue size, which is why the lot keeps its floors by id as well as in a list. \"Does a car fit a compact spot\": a small table, vehicle type to sizes, smallest first. Every scan avoided here is a question not fumbled in the concurrency round, because the scan would have been inside the lock.",5),
("Move 6: anything with a life cycle is a state machine, and the order of operations is part of the design.","A ticket is ISSUED at entry, PAID when the money moved, CLOSED when the spot is freed, LOST if reported lost. Writing the states down forces the question the interviewer will ask: what if payment fails? The answer is an order: peek the ticket, price it, take the payment, and only then commit (PAID, remove, release, vacate, CLOSED). A declined card leaves everything as it was and the driver retries; a second checkout finds no ticket and is refused. Lost ticket is the same order with the daily cap as the fee.",6),
("Move 7: yes, the lock makes parks happen one at a time. Ask for how long, and what is inside it.","The question you will be asked, and should ask yourself: if every park takes the same lock, is the whole car park now a queue? It is, for about a microsecond and a half. Inside the lock there is a map lookup, a walk over a handful of floors, one queue poll, two field writes and a map put. Everything slow is outside it: printing the ticket, lifting the barrier, the display board, the driver. So when ten gates press at the same instant, the tenth waits about fourteen microseconds for the lock and then spends two seconds lifting its own barrier arm. One by one is true and nobody can tell, as long as nothing slow gets inside. The one slow thing inside today is the card payment in <code>unpark</code>, which is why it is the first rung of the ladder in the next move.",7),
("Move 8: say the arithmetic, then name the ladder.","Ten gates admitting a car every three seconds is about three parks a second, five microseconds of lock in every second: busy a millionth of the time, and two parks collide about once a day. The barrier arm serialises cars far more than the lock does. Then the ladder, in the order you would climb it: take payment outside the lock with a PAYING state and commit in a second short section; a lock per floor, so gates on different floors never wait for each other; compare-and-set per spot, which claims occupant null to vehicle in one hardware step and sends the loser to the next spot. Say the arithmetic first: climbing the ladder without it is complexity nobody asked for.",8),
("Move 9: list what can go wrong, and write the test for each before the interview is over.","Payment fails at exit (the spot must not leak, and the driver must be able to retry). The display board throws (the queue must not lose a spot). Two gates, one spot (exactly one winner out of fifty). The same plate at two gates (one car gets one spot; the second gate is refused). Sixty minutes and one millisecond is two hours, and exactly sixty minutes is one. The board asking a thousand times a second (nobody at a gate waits for a screen). Time comes from an injected clock, so a test can say 'Saturday 10:00' and mean it. Each of these is a few lines in FailureTests.java, which runs seventy checks and prints ALL PASS or exits non-zero; a design that cannot show its tests is a claim.",9),
("Move 10: now, and only now, name the patterns. Each one is the result of a move.","Every pattern on this page came out of a move, which is why each can be defended in one sentence: a rule that changes went behind an interface (Strategy); a rule that adds to another wraps it (Decorator); the floor announces and the board listens (Observer); the ticket's life is a fixed set of moves (State); one lot per process, at the edge only (Singleton: the gates are handed the lot, they never call <code>getInstance</code>). Factory did not earn a place: vehicles arrive already typed; it earns one the moment a vehicle is built from a string in a config file. When asked 'where would you use Builder?', the right answer is 'nowhere yet, and here is what would make me'. A pattern without a move behind it is decoration.",10),
("Move 11: run SOLID as a check on the moves, one line each.","SOLID is not a list to recite; it is the check that the moves did their job. S: a class has one reason to change, which move 2 gave you (a spot changes only when its occupant does, a floor only when its free queues do, the lot only when the flow does). O: a new behaviour is a new class and one changed line, never an opened one (surge). L: any implementation drops in and nothing asks which one it got (the lot calls <code>pricing.price(t)</code>, never 'is it the surge one?'). I: the three interfaces have one method each, so a fake for a test is one line. D: the lot depends on interfaces and is handed the implementations, which is exactly why a test can hand it a clock that says Saturday and a card that declines.",11),
("Move 12: every twist the interviewer adds is one of five moves. Say which before you type.","A new rule (nearest to the exit, a monthly pass, fifteen free minutes, a daily cap, a charge per unit of electricity) is a new class behind an existing interface plus one configure line; several at once is those classes wrapped round each other, and the order of wrapping is the answer. Someone new who wants to know (SMS, analytics, a board that must not fall behind) is one more observer; the floor does not change. A new step in a life (reserved, paying, towed) is a new state and one row in the transition table. A new invariant across spots (a truck needs two adjacent spots; a booking holds one until six o'clock) is every claim inside the same lock, all or nothing. State that must outlive the process (persist it; many branches) is the two maps behind a repository interface, and the spot claim becomes a conditional UPDATE where the vehicle is still null: the database's compare-and-set, the same idea as the lock, one atomic step decides the winner. For all five the services do not change; that is the test that the derivation was right. Page 05 has the code for each.",12),
]

# ---------- follow-ups and practice: question, plain answer about what the code does, code
FU=[
("They want weekend surge, 1.5x. Then a daily cap. Then the first fifteen minutes free. Then monthly passes. Where does each one go?","functional",10,
 "Pricing is already an interface, so every one of them is a new class that wraps the rule before it, and <code>ParkingLot</code> never opens: the only edit is the line that hands the pricing in. Surge asks the wrapped rule for the price and multiplies by 1.5 on Saturday and Sunday, reading the ticket's exit day, which the lot's injected clock stamped, so a test can make any day a Saturday. The cap returns the smaller of its own cap and the wrapped price. The grace returns zero below fifteen minutes and otherwise defers. The pass checks the plate against a set. The real question is the ORDER of the wrapping, and it has one answer: the cap goes outside the surge, or the surge multiplies the cap; the grace goes innermost, because free is free whatever the day; the pass goes outermost, because a pass holder pays nothing whatever else applies.",
 sect("class WeekendSurgePricing","class EntryGate")+"\n"+X("pricing rules stack","electric spots")
 +"\n// the one line that changes in the lot's setup:\nlot.configure(new MonthlyPassPricing(new DailyCapPricing(new WeekendSurgePricing(\n        new FreeGracePricing(new FlatHourlyPricing(), 15), ZoneId.of(\"Asia/Kolkata\")), 500), passHolders),\n    new SmallestFitStrategy());\n"),
("Two cars, two gates, one compact spot left. Prove it cannot double-book, with a test.","non-functional",10,
 "The race lives in the gap between reading 'C1 is free' and writing 'C1 is taken'. <code>park</code> does find, take and assign inside one lock, so no other gate can run in that gap. The proof is a test, not a paragraph: fifty gates wait on one latch, the latch opens, all fifty call park for the last compact spot, and the test counts the tickets that came back. Exactly one; the other forty-nine get 'Lot full for CAR'. It then checks that the lot is full and that the free count is zero, because 'one winner' would also be true if the spot had simply been lost.",
 tests[tests.index("        // 11. the race"):tests.index("        // 12. nearest")]),
("Ten gates on one lock. Does that scale, or are you serialising the whole car park?","non-functional",5,
 "It serialises them, for about a microsecond and a half each. Inside the lock there is a map lookup, a walk over a handful of floors, one queue poll and two field writes; everything slow is outside it: printing the ticket, lifting the barrier, the board, the driver. Ten gates admitting a car every three seconds is three parks a second, so the lock is busy five microseconds in every million: the barrier arm serialises cars far more than the lock does. The one slow thing still inside the lock is the card payment at exit, about half a second, and that is the honest weak spot. The ladder, cheapest first: take the payment outside the lock with a PAYING state and commit in a second short section; then a lock per floor; then compare-and-set on each spot. Climb it only when the arithmetic says to, and know what each rung costs: the per-floor lock below no longer holds the duplicate-plate check and the spot claim together.",
 X("ladder rung 2","ladder rung 3")+"\n"+X("ladder rung 3","two adjacent spots")),
("A driver lost the ticket. Implement it.","functional",10,
 "The duration is unknown, so the fee is a flat daily cap. <code>reportLost</code> does the same thing as <code>unpark</code> in the same order: find the ticket without removing it, take the cap as payment, and only then mark it LOST, remove it, release the spot, give the spot back to the floor and mark CLOSED. If the payment fails nothing has changed and the driver can try another card. The exit gate has a <code>lostTicket</code> method so the barrier flow is the same as a normal exit. The transition table in the second block is the explicit version of the rule: every move that is not in the table throws, so a close before a pay is refused rather than quietly done.",
 ext_lost+"\n"+X("ticket's life as an explicit","reservations")),
("Payment fails at the exit gate. What is the state of the system, and show me the code handling it.","functional",10,
 "Nothing is half done. <code>unpark</code> peeks the ticket (it does not remove it), stamps the exit time, prices it, and asks the payment processor. If that returns false it throws and returns: the ticket is still ISSUED, the spot is still held, the driver tries another card or pays cash. Only after a successful payment does it mark PAID, remove the ticket from the active map, release the spot, give it back to the floor's queue, and mark CLOSED. A second checkout finds no active ticket and is refused, so nobody is charged twice and no spot is freed twice. The second block is the same order written against the transition table, where an illegal move cannot pass even by accident.",
 sect("    double unpark(String plate","    Map<SpotType, Integer> availability()")+"\n"+notail(X("the exit order, written","class ExtDemo"))),
("The app asks 'how many compact spots are free on floor 2?' a thousand times a second. Make it O(1).","non-functional",5,
 "No new structure is needed. Each floor already keeps a queue of free spots per size, so the answer is the size of floor 2's compact queue. The lot keeps its floors in a map by id as well as in a list, so finding floor 2 is O(1) too, and <code>freeCount(floorId, size)</code> reads it under the lock so a count is never torn by a park happening at that instant; that costs tens of nanoseconds, not milliseconds. Lot-wide <code>availability()</code> sums the same numbers over floors and sizes, never a scan of spots. An unknown floor id is an error, not a zero. At a million spots and a hundred floors, keep a running count per floor and size updated under the same lock and the sum is O(1) as well.",
 ext_avail+"\n// on the floor, the number itself:\nint freeCount(SpotType st) { return free.get(st).size(); }   // O(1)\n"),
("The display board refreshes a thousand times a second and the renderer is slow. What happens to the gates?","non-functional",5,
 "Nothing, and that is the point of publishing after the lock. <code>park</code> takes a snapshot of the counts inside the lock, releases the lock, and only then calls the observers, each in a try/catch, so a board that throws or takes a second delays nobody's spot and corrupts nothing. What is still wrong at a thousand updates a second is queueing them: a board only ever shows the newest number, so the ones in between are worth nothing. The coalescing board stores the newest counts per floor in one map write, which is all the calling gate ever does, and the board's own thread renders whatever is newest when it gets round to it. A thousand updates become one render, and the number shown is the last one, not the first.",
 sect("    void publish(Map<SpotType, Integer> counts)","}\n\n/** How money is taken at exit")+"\n"+X("display board at a thousand","ladder rung 2")),
("Now a truck needs two adjacent large spots.","twist",10,
 "Spots gain a neighbour link: a map from a spot id to the spot beside it, from configuration. The search looks for two free neighbouring large spots and returns them as a pair, deterministically (ids in order), and a spot with no neighbour mapped simply has no run. The ticket holds a list of spots instead of one. The reservation is the whole point: the pair is found, both spots are taken out of the floor's queues and both are assigned, all inside one locked section, so a second truck arriving in the middle can never be handed half a pair. Either both moved or nothing was touched. Say the word atomic. Note which way this cuts: it is easy under a lock and hard with compare-and-set per spot, which is a reason not to climb that rung.",
 X("two adjacent spots","persistence")),
("Nearest spot to the exit instead of smallest fit.","twist",5,
 "The question has two halves and the interviewer wants both. Which free spot of a given size comes next is the ORDER of that size's queue, so the floor is built with a heap keyed by metres from the exit instead of a deque: the head is now the nearest, <code>peekFree</code> is unchanged, and taking or returning a spot costs O(log n) instead of O(1). Which size to prefer is still the strategy, so <code>NearestToExit</code> compares the heads of the fitting sizes and returns the closest of them. Both are handed in; the lot does not change. Be honest about the trade: this rule will give a car a large spot ten metres away over a compact spot fifty metres away, which is exactly what smallest-fit existed to prevent, so a real lot weights distance against wasted size.",
 X("nearest to the exit","ticket's life as an explicit")+"\n"+sect("    /** A floor that hands out any free spot","    /** Subscribe a listener; setup only. */")),
("Half the spots have chargers. An electric car should get one, and pay for the electricity.","twist",10,
 "A charger is behaviour, not a label, so the spot earns a subclass: <code>EvSpot</code> starts the meter when a vehicle is assigned and stops it when the spot is released, which is why it overrides those two methods rather than carrying a boolean. The fee is one more pricing wrapper: the wrapped rule's parking fee plus the meter reading times the price per unit, and only when the ticket's spot is an <code>EvSpot</code>. Which car gets which spot is the assignment rule, which is handed the whole vehicle: an electric car takes a free charger first, and a petrol car leaves the chargers alone while any ordinary spot of its size is free, taking one only as a last resort. Both of those are a scan of the floor here, which is the price of adding a kind of spot from outside the enum; give EV its own SpotType and both are O(1) again.",
 X("electric spots","nearest to the exit")),
("Let people book a spot for six o'clock. What if they never turn up?","twist",10,
 "A booking is not a note on an empty spot, it is an occupant: the desk takes a fitting spot out of the floor's queue and assigns a placeholder vehicle in the name of the plate that booked it, so 'is this spot free?' stays one question with one answer and no walk-in can be given it. Claiming swaps the placeholder for the real vehicle and issues the ticket. The never-turned-up case is a deadline on the hold plus a sweep: anything past its deadline is released and put back in the queue, and a claim that arrives after the deadline is refused and returns the spot too. It is shown as its own class with its own lock so <code>Main.java</code> stays the sixty-minute core; inside the lot it is three more methods under the one lock, in the same order: take the spot, then record the hold.",
 X("reservations","display board at a thousand")),
("Persist it. Or: now there are many branches, in different processes.","twist",5,
 "The two maps in the lot go behind a repository interface (find a ticket by plate, save, remove) and the in-memory version becomes one implementation; the services above do not change. The spot claim is the interesting half. In one process it is a queue poll under a lock; across processes it becomes one conditional update, <code>UPDATE spot SET plate = ? WHERE id = ? AND plate IS NULL</code>. One row updated means you got it, zero means someone else did, and no lock is held across the network while a gateway is slow. That is the database's compare-and-set, the same idea the <code>ReentrantLock</code> was buying: one atomic step decides the winner. The test runs fifty callers at one row and counts one update.",
 X("persistence","the exit order, written")),
("Where does time come from, and how do you test the weekend rule on a Tuesday?","design",5,
 "The lot is handed a <code>Clock</code>, a one-method interface. It stamps the entry and exit times on the ticket, and every pricing rule reads the ticket, never the wall clock; the charging meter reads the same clock. So a test hands in a clock that says Saturday 10:00, parks, moves the clock forward an hour, unparks, and checks the fee is 20 times 1.5; then it sets the same clock to a Tuesday and checks the same code charges 20. Nothing sleeps, nothing is flaky, and the same trick tests the billing edge (sixty minutes and one millisecond is two hours) and a reservation expiring.",
 tests[tests.index("        // 7. billing"):tests.index("        // 9. taking")]+"\n"+X("time is injected","pricing rules stack")),
("Which pattern is where, and why did each one earn its place?","design",5,
 "None of them was chosen up front; each is what a move produced, which is why each can be defended in one sentence. Strategy is move 3: pricing, assignment and payment are rules that will change, so each sits behind a one-method interface the lot is handed. Decorator is the pricing stack: surge, cap, grace and pass each wrap the rule before them instead of replacing it, which is why four rules need no new interface. Observer is move 4's rule that the board must not be inside the lock: the floor announces 'counts changed' to whoever subscribed. State is move 6: the ticket's life written down so an illegal move throws. Singleton is only <code>getInstance()</code> at the edge; gates are handed the lot and tests build their own. Two you should NOT claim: there is no Factory yet, because vehicles arrive already typed, and no Builder, because nothing here has a long optional constructor.",
 "// Strategy: a rule behind an interface, handed in\ninterface PricingStrategy { double price(Ticket t); }\nvoid configure(PricingStrategy p, SpotAssignmentStrategy a) { pricing = p; assignment = a; }\n\n// Decorator: wrap the rule before you, add to it; four rules, no new interface\nnew MonthlyPassPricing(new DailyCapPricing(new WeekendSurgePricing(new FreeGracePricing(flat, 15), zone), 500), passes)\n\n// Observer: the floor announces; it does not know what a screen is\ninterface ParkingObserver { void onChange(String floorId, Map<SpotType, Integer> free); }\nchanged.publish(counts);   // AFTER lock.unlock()\n\n// State: the ticket's life as a table; an illegal move throws\nenum TicketState { ISSUED, PAID, LOST, CLOSED; /* ALLOWED = {ISSUED->PAID|LOST, PAID->CLOSED, LOST->CLOSED} */ }\n"),
("Which SOLID letter is where in this code?","design",5,
 "S: each class has one reason to change. The spot tracks its occupant, the floor its free queues, the lot the flow and the lock, a pricing class the money; nobody does two of those. O: weekend surge, the cap, the grace and the pass were four new classes and one changed line, and the lot never opened. L: any PricingStrategy drops in and the lot never asks which one it got. I: the interfaces have one method each, so a fake for a test is one lambda; a payment class is never asked to price. D: the lot depends on the interfaces it is handed in <code>configure()</code> and <code>setClock()</code>, not on FlatHourlyPricing, which is exactly why a test can hand it a clock that says Saturday and a card that declines.",
 "// S: one reason to change each\nclass ParkingSpot { /* its occupant */ }   class ParkingFloor { /* its free queues */ }   class ParkingLot { /* the flow + the lock */ }\n// O: new behaviour = new classes, one changed line, nothing opened\nlot.configure(new DailyCapPricing(new WeekendSurgePricing(new FlatHourlyPricing(), zone), 500), new SmallestFitStrategy());\n// L: any implementation drops in; the lot never checks the concrete type\ndouble fee = pricing.price(t);\n// I: one method per interface\ninterface PaymentProcessor { boolean pay(double amount); }\n// D: depend on the interface, hand in the implementation; tests hand in fakes\nlot.setClock(() -> fixedSaturdayMs);   lot.unpark(\"AAA\", amount -> false);   // a declining card\n"),
("Enum sizes or Spot subclasses? And where would you use a Factory?","design",3,
 "Enum, until a size gains behaviour of its own. Three sizes that differ only in what fits and what they cost are data: a row in the fit table and a rate in a map. A charging spot is the counter-example, and it is in the code above: it has a meter that must start and stop with the car, so it overrides <code>assign</code> and <code>release</code> and earns a subclass. Note the cost of that choice here: because the sizes are a closed enum, an EV spot added from outside cannot get its own queue and the rule has to scan; if kinds of spot must be open, the enum becomes a registry of spot kinds loaded from configuration. That is also when Factory earns its place: a map from a name to a constructor turns adding a kind into one registration instead of a growing switch.",
 "// data, not classes: a size is a row\nstatic final Map<VehicleType, List<SpotType>> ORDER = Map.of(VehicleType.CAR, List.of(SpotType.COMPACT, SpotType.LARGE), /* ... */);\nstatic final Map<SpotType, Integer> RATE = Map.of(SpotType.SMALL, 10, SpotType.COMPACT, 20, SpotType.LARGE, 40);\n\n"
 +notail(X("electric spots","nearest to the exit").split("/**\n * An electric car gets")[0])+"\n// a factory only once creation logic grows: a registry, so a new kind is one registration\nMap<String, BiFunction<String, SpotType, ParkingSpot>> registry = Map.of(\"EV\", (id, t) -> new EvSpot(id, t, 7.0, clock));\nParkingSpot s = registry.get(kind).apply(id, size);\n"),
]


HL_JS=r'''function hl(src){let inDoc=false;return src.split('\n').map((l,i)=>{let e=l.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');const t=e.trim();let out;if(inDoc||t.startsWith('/**')){out='<span class="d">'+e+'</span>';if(t.startsWith('/**'))inDoc=!t.endsWith('*/');else if(t.endsWith('*/'))inDoc=false;}else{const parts=e.split(/(\/\/.*$|"(?:[^"\\]|\\.)*")/);out=parts.map((p,j)=>j%2?(p.startsWith('//')?'<span class="c">'+p+'</span>':'<span class="s">'+p+'</span>'):p.replace(KW,'<span class="k">$1</span>').replace(TY,'<span class="t">$1</span>').replace(/\b(\d+(?:\.\d+)?)\b/g,'<span class="n">$1</span>')).join('');}return '<span class="ln">'+(i+1)+'</span>'+out;}).join('\n');}'''
# ---------- steps for the workbench frame
def ed_prac(code,tab="reference",key=None): return '<div class="ed"><div class="tab"><b>'+tab+'</b><button class="copy" data-key="'+(key or '')+'">copy</button></div><pre><code class="java">'+esc(code)+'</code></pre></div>'
S=[]
REQ_HTML='''<div class="req"><div><b>Functional requirements</b><ul><li>Park: find the smallest free spot that fits, mark it taken, issue a ticket.</li><li>Unpark: take the ticket, compute the fee from time parked, take payment, free the spot.</li><li>Three vehicle kinds (motorcycle, car, truck), three spot sizes (small, compact, large); a bigger spot may hold a smaller vehicle.</li><li>Pricing: hourly by spot size, rounded up, and changeable without touching the rest.</li><li>Payment at exit by cash or card.</li><li>Answer "is it full for a truck?" and "how many compact spots are free on floor 2?"</li><li>Reject when full.</li></ul></div>
<div><b>Non-functional requirements</b><ul><li>Many gates at the same time: two vehicles must never get the same spot.</li><li>Finding a spot must not scan every spot: one step per size, O(1).</li>
<li>Which spot of a size is handed out is itself a rule, swappable without touching the lot.</li><li>Pricing and assignment rules swappable without changing the core.</li><li>One source of truth for which spots are taken: the floor's per-size free queue.</li>
<li>The display board never holds up a gate, however often it asks and however slow it is.</li><li>Nothing half-done: a failed payment leaves the driver parked and able to retry.</li><li>In memory, one process, no persistence (say it; a follow-up adds it).</li></ul></div></div>
'''
# 1 problem
PROBLEM_BODY=('<div class="move"><div class="prompt">"Design a parking lot. Multiple floors, different vehicle sizes. Cars enter through entry gates and leave through exit gates; a ticket on the way in, payment on the way out. I want working code, not a diagram. Go."</div></div>'
 '<div class="move"><h3>The problem, in plain words</h3><p>A building with several floors of parking spots. Spots come in three sizes and vehicles in three kinds, and a bigger spot may take a smaller vehicle. A vehicle drives up to an entry gate: the system must find it a free spot that fits, hand it a ticket, and remember which spot it took. At an exit gate the driver shows the ticket: the system works out the fee from the time parked, takes the payment, and frees the spot. A display board shows how many spots of each size are free on each floor. Several gates work at the same time, so two vehicles must never be given the same spot, and a failed payment must leave the driver parked, not the spot lost.</p></div>'
 '<div class="move"><h3>What is expected of you in the hour</h3><p>Not a diagram: classes that compile and run, with a <code>main</code> that parks and unparks a few vehicles. The interviewer is watching for, in this order: the questions you ask before typing; which classes exist and which one owns which state; park and unpark working end to end; what happens when two gates race for the last spot; where the rules that will change (pricing, which spot to pick, how to pay) live, so a change is a new class and not an edit; what happens when payment fails. Then the twists: surge pricing, a lost ticket, nearest-to-exit, charging spots, reservations, a truck needing two spots, persistence.</p></div>'
 '<div class="move"><h3>What the code must do</h3></div>'+P_FLOWS+
 '<div class="move"><h3>Questions to ask back, and what each answer decides</h3></div>'+'''<div class="move"><table class="ask"><tr><th>Ask</th><th>Assume this when they say "you decide"</th><th>What the answer decides</th></tr>
<tr><td>How many gates, and do they act at the same time?</td><td>Many, at the same time</td><td>One lock in the lot; the gates are thin callers (moves 1, 4, 7)</td></tr>
<tr><td>Which vehicles, which spot sizes, does bigger hold smaller?</td><td>Three and three; yes</td><td>The fit table, smallest first (move 5)</td></tr>
<tr><td>Which spot when several fit?</td><td>First floor that has one, then the smallest size</td><td>Assignment behind an interface (move 3)</td></tr>
<tr><td>How is it billed?</td><td>Hourly by spot size; any started hour counts</td><td>Pricing behind an interface; time is handed in (moves 3, 9)</td></tr>
<tr><td>When and how is it paid, and can it fail?</td><td>At exit; card or cash; yes</td><td>Pay before commit; the ticket's states (move 6)</td></tr>
<tr><td>Is the board allowed to be slow, and how often does it ask?</td><td>Yes, and constantly</td><td>Observers run after the lock; counts are O(1) (moves 4, 5)</td></tr>
<tr><td>One process, in memory?</td><td>Yes</td><td>No repository yet; a follow-up adds one (move 12)</td></tr>
<tr><td>Monthly passes, charging spots, reservations?</td><td>Out of scope, named</td><td>Each is one of the five twist moves (move 12)</td></tr></table></div>'''+
 '<div class="move"><h3>What it must do, and what it must survive</h3></div>'+REQ_HTML+
 '<div class="move"><h3>One afternoon, replayed</h3></div>'+P_EX+
 '<div class="grade"><b>Say before typing:</b> one lot, in memory, one process; one vehicle takes one spot; any started hour is billed; the first floor with a fitting spot wins, then the smallest size on it. Named as out of scope: monthly passes, charging spots, reservations, a truck that needs two spots; each is a follow-up on page 05.</div>')
S.append(dict(id=0,stage="Problem",title="The problem, and what it must do",wide=True,think="",body=PROBLEM_BODY,code=""))
# 2 derivation: all eight moves on one page
der='<div class="move"><p class="lead">Run these on any LLD (elevator, BookMyShow, Splitwise) and the class diagram, the lock, the tests, the patterns, SOLID and the answer to every twist fall out in that order; nothing is chosen up front, and nothing is named before the move that produced it.</p></div>'
for i,(t,txt,k) in enumerate(MOVES,1): der+='<div class="move"><h3>%s</h3></div>'%t+MV[k]+'<div class="move"><p>%s</p></div>'%txt
S.append(dict(id=0,stage="Derivation",title="From the requirements to the design: twelve moves",wide=True,think="",body=der,code=""))
# 3 design
S.append(dict(id=0,stage="Design",title="The whole design: the class diagram",wide=True,think="",body='<div class="fullboard">'+UMLSVG+'</div><div class="move"><p><b>How to read a box.</b> Top: the class name (<i>italic</i> = abstract, never <code>new</code>-ed; dashed border = interface; &laquo;enum&raquo; = a fixed list of values). Middle: its fields, the state it holds. Bottom: its methods. <b>The arrows.</b> Hollow triangle = extends or implements. Filled diamond = owns: the lot owns floors, a floor owns spots, the lot owns the active tickets. Plain arrow = references: a ticket points at its spot, floor and vehicle. Dashed green = handed in through <code>configure()</code>. Dotted blue = notifies. <b>Where state lives:</b> the floor has the free queues and the observers; the lot has the floors, the active tickets, the handed-in rules and the one lock; a spot has its occupant; a ticket has its spot, floor, vehicle, times and status. On the next step this diagram stays on the right while you read the code.</p></div>',code=""))
# 4 the whole code: Main.java, then Extensions and the tests below it on the same page
def edblock(code,tab,key): return '<div class="ed"><div class="tab"><b>'+tab+'</b><button class="copy" data-key="'+key+'">copy</button></div><pre><code class="java">'+esc(code)+'</code></pre></div>'
codepage='<div class="move"><p>Read it with page 03 open in a second tab if you want the diagram beside it. The green comment above each class and method says what it does; read only those first for the shape, then the bodies for the mechanics. Each copy button copies that whole file for your IDE. Below Main.java: Extensions.java (the reference code for every follow-up on page 05, written against these same interfaces) and FailureTests.java (seventy checks, one per claim this page makes; <code>javac Main.java Extensions.java FailureTests.java &amp;&amp; java FailureTests</code> prints ALL PASS).</p></div>'+edblock(src,"Main.java","main")+edblock(ext,"Extensions.java","ext")+edblock(tests,"FailureTests.java","tests")
S.append(dict(id=0,stage="Code",title="The whole code",wide=True,think="",body=codepage,code=""))
# 5 follow-ups and practice: everything on one page
fu='<div class="grade"><b>How to use this page.</b> First implement the whole system from a blank <code>Main.java</code>, sixty minutes, until a main compiles and runs. Then take the questions one at a time: read it, start its timer, answer <i>in code</i> in your own file, and only then open the fold. The fold says in plain English what the reference code does, then shows it, with a copy button. The miss log at the bottom is the output of the session.</div>'
fu+='<div class="card"><div class="ch"><h3>0 &middot; Implement the system</h3><button class="timer" data-min="60">start 60:00</button></div><div class="cb"><div class="prompt">"Design a parking lot. Multiple floors, different vehicle sizes. Cars enter through entry gates and leave through exit gates; a ticket on the way in, payment on the way out. I want working code, not a diagram. Go."</div>Before typing, write your five to eight clarifying questions; then type in the order of Main.java: enums, vehicle, spot and the fit table, ticket, the three one-method interfaces with one implementation each, the floor with its per-size free queues, the lot with its lock and the exit order, the gates, a main with the race. If the clock runs out, the one thing that must exist is park and unpark under one lock with the payment before the commit.</div></div>'
for i,(q,kind,mins,ans,code) in enumerate(FU,1):
    fu+='<div class="card"><div class="ch"><span class="kind">%s</span><h3>%d &middot; %s</h3><button class="timer" data-min="%d">start %d:00</button></div><div class="cb"><details><summary>Answer, after the timer</summary><div class="ans"><p>%s</p>%s</div></details></div></div>'%(kind,i,esc(q),mins,mins,ans,ed_prac(code))
fu+='<div class="card"><div class="ch"><h3>Miss log</h3></div><div class="cb"><div class="miss"><p>Three specific lines: what the reference did that you did not. Saved in this browser.</p><textarea id="miss" placeholder="1.&#10;2.&#10;3."></textarea></div></div></div>'
S.append(dict(id=0,stage="Follow-ups and practice",title="Follow-ups and practice",wide=True,think="",body='<div class="prac on">'+fu+'</div>',code=""))
for i,st in enumerate(S): st["id"]=i+1
raw={"main":src,"ext":ext,"tests":tests}
# ---------- practice pane: the follow-ups with question -> plain answer -> code (+copy)
def prac_html():
    out=['<div class="card"><div class="ch"><h3>How practice runs</h3></div><div class="cb">First implement the whole system from a blank <code>Main.java</code>, sixty minutes, until a main compiles and runs. Then take the questions one at a time: read it, start its timer, answer <i>in code</i> in your own file, and only then open the fold. The fold says in plain English what the reference code does, then shows it, with a copy button. The miss log at the bottom is the output of the session.</div></div>',
         '<div class="card"><div class="ch"><h3>0 &middot; Implement the system</h3><button class="timer" data-min="60">start 60:00</button></div><div class="cb"><div class="prompt">"Design a parking lot. Multiple floors, different vehicle sizes. Cars enter through entry gates and leave through exit gates; a ticket on the way in, payment on the way out. I want working code, not a diagram. Go."</div>Before typing, write your five to eight clarifying questions; then type in the order of Main.java: enums, vehicle, spot and the fit table, ticket, the three one-method interfaces with one implementation each, the floor with its per-size free queues, the lot with its lock and the exit order, the gates, a main with the race. If the clock runs out, the one thing that must exist is park and unpark under one lock with the payment before the commit.</div></div>']
    for i,(q,kind,mins,ans,code) in enumerate(FU,1):
        out.append('<div class="card"><div class="ch"><span class="kind">%s</span><h3>%d &middot; %s</h3><button class="timer" data-min="%d">start %d:00</button></div><div class="cb"><details><summary>Answer, after the timer</summary><div class="ans"><p>%s</p>%s</div></details></div></div>'%(kind,i,esc(q),mins,mins,ans,ed_prac(code)))
    out.append('<div class="card"><div class="ch"><h3>Miss log</h3></div><div class="cb"><div class="miss"><p>Three specific lines: what the reference did that you did not. Saved in this browser.</p><textarea id="miss" placeholder="1.&#10;2.&#10;3."></textarea></div></div></div>')
    return "".join(out)
steps_js=json.dumps(S); raw_js=json.dumps(raw)
page=f'''<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Parking Lot -- LLD</title>
<style>
:root{{--bg:#0f1419;--bg2:#161b22;--bg3:#1c2330;--line:#2a3441;--text:#d6dde6;--muted:#7d8896;--acc:#3ddbb0;--acc2:#7cc4ff;--warn:#f0a35e;--err:#ff6b6b;--mono:"JetBrains Mono","SF Mono",Menlo,Consolas,monospace;--ui:-apple-system,"Segoe UI",Inter,Roboto,sans-serif}}
*{{box-sizing:border-box}} html,body{{margin:0;height:100%;background:var(--bg);color:var(--text);font-family:var(--ui);font-size:14px}}
.top{{height:48px;display:flex;align-items:center;gap:16px;padding:0 16px;background:var(--bg2);border-bottom:1px solid var(--line)}}
.top h1{{font-size:15px;font-weight:600;margin:0}} .top .sub{{color:var(--muted);font-size:12px}}
.mode{{margin-left:auto;display:flex;border:1px solid var(--line);border-radius:6px;overflow:hidden}} .mode button{{background:transparent;color:var(--muted);border:0;padding:6px 14px;cursor:pointer;font:inherit}} .mode button.on{{background:var(--acc);color:#04211a;font-weight:600}}
.kbd{{font-family:var(--mono);font-size:11px;border:1px solid var(--line);border-radius:4px;padding:1px 5px;color:var(--muted)}}
.wrap{{display:grid;grid-template-columns:240px 1fr 520px;height:calc(100% - 48px)}} .wrap.code{{grid-template-columns:220px 1fr 640px}} .wrap.wide{{grid-template-columns:240px 1fr 0}} .wrap.wide .right{{display:none}}
.side{{background:var(--bg2);border-right:1px solid var(--line);overflow:auto;padding:10px 0}}
.side .grp{{padding:10px 16px 4px;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}}
.side .st{{display:flex;gap:10px;align-items:baseline;padding:7px 16px;cursor:pointer;border-left:3px solid transparent}} .side .st:hover{{background:var(--bg3)}} .side .st.on{{border-left-color:var(--acc);background:var(--bg3)}} .side .st.done{{color:var(--muted)}}
.side .st .n{{font-family:var(--mono);font-size:11px;color:var(--muted);min-width:18px}}
.main{{overflow:auto;padding:0 24px}} .study{{max-width:1280px;margin:0 auto}} .right{{background:var(--bg2);border-left:1px solid var(--line);overflow:auto;padding:14px}}
.hdr{{padding:16px 22px 8px;display:flex;align-items:baseline;gap:12px}} .hdr h2{{margin:0;font-size:18px;font-weight:600}} .hdr .stage{{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--acc);border:1px solid var(--acc);border-radius:4px;padding:2px 7px}}
.think{{margin:8px 22px 14px;padding:12px 14px;background:var(--bg3);border-left:3px solid var(--acc2);border-radius:0 6px 6px 0;line-height:1.55}} .think b{{color:var(--acc2)}} .fullboard{{margin:0 0 14px;padding:10px;background:var(--bg);border:1px solid var(--line);border-radius:8px}} .fullboard svg{{width:100%;height:auto;display:block}} .fullboard.mv{{margin:8px 0 10px;padding:6px}} .fullboard .nd,.fullboard .e,.fullboard .el{{opacity:1!important}} .fullboard .nd rect{{fill:var(--bg3)!important;stroke:var(--line)!important}} .think table{{border-collapse:collapse;width:100%;margin:8px 0;font-size:13px}}  .think th,.think td{{text-align:left;padding:6px 8px;border-bottom:1px solid var(--line);vertical-align:top}} .think th{{color:var(--muted);font-weight:500}} .think code{{font-family:var(--mono);font-size:12px;color:var(--acc)}}
.say{{margin:0 22px 6px;color:var(--muted);font-size:13px}} .prim{{margin:0 22px 12px;font-size:12px;color:var(--muted)}} .prim a{{color:var(--acc2);font-family:var(--mono)}} .say::before{{content:"say aloud: ";color:var(--warn);font-weight:600}}
.ed{{margin:0 22px 20px;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--bg2)}}
.ed .tab{{display:flex;gap:8px;align-items:center;padding:6px 12px;background:var(--bg3);border-bottom:1px solid var(--line);font-family:var(--mono);font-size:12px;color:var(--muted)}} .ed .tab b{{color:var(--text);font-weight:500}}
.ed .chips{{display:flex;gap:6px;flex-wrap:wrap;padding:8px 12px;border-bottom:1px solid var(--line);background:var(--bg2)}} .chip{{font-size:10px;border:1px solid var(--line);border-radius:999px;padding:1px 7px;color:var(--muted)}} .chip.new{{border-color:var(--acc);color:var(--acc)}}
pre{{margin:0;padding:14px 0;overflow-x:auto;font-family:var(--mono);font-size:12.5px;line-height:1.6;tab-size:4}} pre .ln{{display:inline-block;width:44px;text-align:right;padding-right:14px;color:#3d4756;user-select:none}}
.copy{{margin-left:auto;font-family:var(--mono);font-size:11px;background:transparent;color:var(--acc);border:1px solid var(--acc);border-radius:999px;padding:2px 10px;cursor:pointer}} .copy:hover{{background:var(--acc);color:#04211a}}
.d{{color:#7fa66f;font-style:italic}} .right-uml{{margin:0}} .right-uml svg{{width:100%;height:auto}} .move{{margin:0 22px 18px}} .move h3{{margin:0 0 6px;font-size:14.5px}} .move p{{margin:6px 0 0;line-height:1.6}} .fullboard{{margin:0 22px 14px;padding:8px;background:var(--bg);border:1px solid var(--line);border-radius:8px}} .fullboard svg{{width:100%;height:auto;display:block}} .req{{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin:0 22px 18px}} .req>div{{background:var(--bg3);border-radius:8px;padding:16px 20px 18px}} .req b{{color:var(--acc)}} .req ul{{margin:6px 0 0;padding-left:18px}} .req li{{font-size:13.5px;line-height:1.55;margin:5px 0}} table.ask{{margin:0 0 6px}} table.ask th{{font-size:12px;color:var(--acc);font-weight:600;padding:8px 10px}} table.ask td{{font-size:13px;line-height:1.5;padding:9px 10px}} table.ask td:first-child{{color:var(--text)}} table.ask td:not(:first-child){{color:var(--muted)}} .move h3{{margin-top:10px}} .grade{{margin:0 22px 14px;background:var(--bg3);border-left:3px solid var(--acc);padding:10px 14px;border-radius:0 6px 6px 0}} .grade b{{color:var(--acc)}} .wrap.wide .right{{display:none}}
.k{{color:#c792ea}} .s{{color:#c3e88d}} .c{{color:#5c6773;font-style:italic}} .n{{color:#f78c6c}} .t{{color:#82aaff}}
.nav{{display:flex;gap:10px;padding:0 22px 24px}} .nav button{{background:var(--bg3);color:var(--text);border:1px solid var(--line);border-radius:6px;padding:8px 14px;cursor:pointer;font:inherit}} .nav button.pri{{background:var(--acc);color:#04211a;border-color:var(--acc);font-weight:600}}
.right h3{{margin:4px 0 10px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}}
#cd{{width:100%;height:auto;display:block}} .nd rect{{fill:var(--bg3);stroke:var(--line);stroke-width:1.2}} .nd text{{fill:var(--text);font-family:var(--mono)}} .nd .lb{{font-size:12px}} .nd .sb{{font-size:9.5px;fill:var(--muted)}}
.nd.iface rect{{stroke-dasharray:4 3}} .nd.enum rect{{rx:14}} .nd{{opacity:0;transition:opacity .3s}} .nd.seen{{opacity:.45}} .nd.cur{{opacity:1}} .nd.cur rect{{stroke:var(--acc);stroke-width:1.8;fill:#12302a}}
.e{{fill:none;stroke:var(--line);stroke-width:1.2;opacity:0;transition:opacity .3s;color:var(--line)}} .e.seen{{opacity:.6}} .e.cur{{opacity:1;stroke:var(--acc);color:var(--acc)}} .e.isa{{}} .e.ref{{stroke-dasharray:4 3}} .e.use{{stroke-dasharray:1.5 3}}
.legend{{display:flex;gap:12px;font-size:11px;color:var(--muted);margin:8px 0 14px;flex-wrap:wrap}} .legend span::before{{content:"";display:inline-block;width:22px;border-top:1.5px solid var(--muted);margin-right:5px;vertical-align:middle}} .legend .own::before{{}} .legend .ref::before{{border-top-style:dashed}} .legend .use::before{{border-top-style:dotted}}
.pat{{margin-top:10px}} .pat div{{display:flex;justify-content:space-between;padding:6px 8px;border-bottom:1px solid var(--line);font-size:12px}} .pat div span:last-child{{color:var(--muted)}} .pat div.on{{color:var(--acc)}} .pat div.on span:last-child{{color:var(--text)}}
/* practice */
.prac{{padding:0 22px}}
.card{{border:1px solid var(--line);border-radius:8px;background:var(--bg2);margin-bottom:16px}} .card .ch{{display:flex;gap:12px;align-items:center;padding:12px 16px;border-bottom:1px solid var(--line)}} .card .ch h3{{margin:0;font-size:15px}} .card .cb{{padding:14px 16px;line-height:1.6}}
.timer{{margin-left:auto;font-family:var(--mono);font-size:12px;background:transparent;color:var(--acc);border:1px solid var(--acc);border-radius:999px;padding:4px 12px;cursor:pointer}} .timer.run{{background:var(--acc);color:#04211a}} .timer.done{{border-color:var(--err);color:var(--err)}}
.kind{{font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--warn);border:1px solid var(--warn);border-radius:4px;padding:2px 6px;white-space:nowrap}} .ans table{{border-collapse:collapse;width:100%;font-size:13px;margin:8px 0}} .ans th,.ans td{{text-align:left;padding:6px 8px;border-bottom:1px solid var(--line);vertical-align:top}} .ans th{{color:var(--muted);font-weight:500}} .ans .ed{{margin:10px 0}} .say2{{margin:8px 0 0;padding:8px 12px;background:#132a24;border-left:3px solid var(--acc);border-radius:0 6px 6px 0}} .say2 b{{color:var(--acc)}}
.prompt{{background:var(--bg3);border-left:3px solid var(--warn);padding:10px 14px;border-radius:0 6px 6px 0;font-style:italic;margin-bottom:10px}}
details{{border:1px solid var(--line);border-radius:6px;padding:8px 12px;margin-top:10px}} summary{{cursor:pointer;color:var(--acc2);font-weight:600}} a{{color:var(--acc)}}
.right .lock{{display:none;color:var(--muted);padding:40px 10px;text-align:center;border:1px dashed var(--line);border-radius:8px}} .right.locked .lock{{display:block}} .right.locked #cd,.right.locked .legend,.right.locked .pat,.right.locked h3:nth-of-type(2){{display:none}} summary small{{color:var(--muted);font-weight:400}}
table{{border-collapse:collapse;width:100%;font-size:13px;margin-top:8px}} th,td{{text-align:left;padding:6px 8px;border-bottom:1px solid var(--line);vertical-align:top}} th{{color:var(--text);font-weight:500;white-space:nowrap}} td{{color:var(--muted)}}
ul.chk{{list-style:none;padding:0;margin:6px 0}} ul.chk li::before{{content:"[ ] ";font-family:var(--mono);color:var(--muted)}}
.miss textarea{{width:100%;min-height:80px;background:var(--bg3);color:var(--text);border:1px solid var(--line);border-radius:6px;padding:8px;font:13px var(--mono)}}
@media (max-width:1100px){{.wrap{{grid-template-columns:200px 1fr}} .right{{display:none}}}}
</style></head><body>
<div class="top"><h1>Parking Lot</h1><span class="sub">LLD &middot; Java &middot; OpenJDK 21: demo, 70 failure checks and a 50-thread race pass</span><span class="sub"><span class="kbd">&larr;</span> <span class="kbd">&rarr;</span> steps</span>
</div>
<div class="wrap">
<nav class="side" id="side"></nav>
<section class="main" id="main">
  <div class="study" id="study"></div>
</section>
<script>
const STEPS={steps_js};
const RAW={raw_js};
function wireCopy(root){{root.querySelectorAll('button.copy').forEach(b=>{{b.onclick=()=>{{const key=b.dataset.key;const txt=key?RAW[key]:b.closest('.ed').querySelector('code').textContent;navigator.clipboard.writeText(txt).then(()=>{{b.textContent='copied';setTimeout(()=>b.textContent='copy',1500);}});}};}});}}
const KW=/\\b(abstract|boolean|break|case|catch|class|continue|default|do|double|else|enum|extends|final|finally|for|if|implements|import|int|interface|long|new|null|package|private|protected|public|return|static|super|switch|synchronized|this|throw|throws|try|void|while|var|record|true|false)\\b/g;
const TY=/\\b([A-Z][A-Za-z0-9]*)\\b/g;
__HL__
let cur=parseInt(localStorage.getItem('pl.step')||'1',10);
const side=document.getElementById('side'),study=document.getElementById('study');
function classesSoFar_unused(n){{const out=[];STEPS.filter(s=>s.id<=n&&s.code).forEach(s=>{{(s.code.match(/(?:class|interface|enum)\\s+([A-Z]\\w*)/g)||[]).forEach(m=>out.push({{name:m.split(/\\s+/)[1],step:s.id}}));}});return out;}}
function render(){{
  side.innerHTML='';let g='';STEPS.forEach(s=>{{if(s.stage!==g){{g=s.stage;side.insertAdjacentHTML('beforeend','<div class="grp">'+g+'</div>');}}side.insertAdjacentHTML('beforeend','<div class="st'+(s.id===cur?' on':s.id<cur?' done':'')+'" data-id="'+s.id+'"><span class="n">'+String(s.id).padStart(2,'0')+'</span><span>'+s.title+'</span></div>');}});
  const s=STEPS[cur-1];
  study.innerHTML='<div class="hdr"><span class="stage">'+s.stage+'</span><h2>'+String(s.id).padStart(2,'0')+' &middot; '+s.title+'</h2></div>'+(s.think?'<div class="think">'+s.think+'</div>':'')+(s.body||'')+(s.code?'<div class="ed"><div class="tab"><b>'+(s.file||'Main.java')+'</b><button class="copy" data-src="ed">copy</button></div><pre><code class="java">'+hl(s.code)+'</code></pre></div>':'')+'<div class="nav"><button id="prev">&larr; prev</button><button id="next" class="pri">next &rarr;</button></div>';
  study.querySelectorAll('pre code.java').forEach(el=>{{el.innerHTML=hl(el.textContent);}});wireCopy(study);wireTimers(study);const miss=document.getElementById('miss');if(miss){{try{{miss.value=localStorage.getItem('pl.miss')||'';}}catch(e){{}}miss.addEventListener('input',()=>{{try{{localStorage.setItem('pl.miss',miss.value);}}catch(e){{}}}});}}
  document.getElementById('prev').onclick=()=>go(cur-1);document.getElementById('next').onclick=()=>go(cur+1);
  document.querySelector('.wrap').classList.toggle('wide',!!s.wide);document.querySelector('.wrap').classList.toggle('code',!!s.code);localStorage.setItem('pl.step',cur);study.scrollIntoView();
}}
function go(n){{if(n<1||n>STEPS.length)return;cur=n;setMode('study');render();}}
side.addEventListener('click',e=>{{const t=e.target.closest('.st');if(t)go(+t.dataset.id);}});
document.addEventListener('keydown',e=>{{const t=e.target;if(t&&(t.tagName==='TEXTAREA'||t.tagName==='INPUT'||t.isContentEditable))return;if(e.key==='ArrowRight')go(cur+1);if(e.key==='ArrowLeft')go(cur-1);}});
const main=document.getElementById('main');
function setMode(m){{}}
function wireTimers(root){{root.querySelectorAll('button.timer[data-min]').forEach(b=>{{const total=+b.dataset.min*60;let left=total,id=null;const show=()=>{{b.textContent=(id?'':'start ')+Math.floor(left/60)+':'+String(left%60).padStart(2,'0');}};b.onclick=()=>{{if(id){{clearInterval(id);id=null;b.classList.remove('run');show();return;}}if(left<=0)left=total;b.classList.remove('done');b.classList.add('run');id=setInterval(()=>{{left--;show();if(left<=0){{clearInterval(id);id=null;b.classList.remove('run');b.classList.add('done');b.textContent='time -- open the fold';}}}},1000);show();}};show();}});}}
render();
</script></body></html>'''
page=page.replace('__HL__',HL_JS)
(H/"parking-lot-workbench.html").write_text(page); print("written",len(page))

# guard: compiles and tests pass
d=tempfile.mkdtemp(prefix="pl_"); open(os.path.join(d,"Main.java"),"w").write(src); open(os.path.join(d,"FailureTests.java"),"w").write(tests); open(os.path.join(d,"Extensions.java"),"w").write(ext)
r=subprocess.run(["/opt/homebrew/opt/openjdk@21/bin/javac","Main.java","FailureTests.java","Extensions.java"],cwd=d,capture_output=True,text=True)
if r.returncode!=0: raise SystemExit("CODE DOES NOT COMPILE:\n"+r.stderr)
r=subprocess.run(["/opt/homebrew/opt/openjdk@21/bin/java","FailureTests"],cwd=d,capture_output=True,text=True)
if "ALL PASS" not in r.stdout: raise SystemExit("TESTS FAIL:\n"+r.stdout[-800:])
print("guard: compiles; failure tests ALL PASS")
