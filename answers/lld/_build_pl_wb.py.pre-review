for k,(t,sub) in enumerate([("Ticket","spot, floor, vehicle, entry time"),("Payment","at exit; card or cash; may fail"),("Display board","free counts per floor, per size")]):
    pw+=_bx(55+k*290,130,250,54,t,sub)
pw+='<rect x="925" y="130" width="250" height="150" rx="6" fill="none" stroke="var(--line)" stroke-dasharray="4 3"/>'+_tx(1050,150,"who fits where, smallest first","var(--acc)",11)
for k,(v,s) in enumerate([("motorcycle","small, compact, large"),("car","compact, large"),("truck","large")]):
