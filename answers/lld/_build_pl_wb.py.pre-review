put("assign",930,330,250,"SpotAssignmentStrategy",[],["find(floor, vehicle): ParkingSpot"],"interface")
put("smallest",930,420,250,"SmallestFitStrategy",[],["find: for size in Fit.ORDER[v.type]:","  floor.peekFree(size)"])
