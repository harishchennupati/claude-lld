def row(t,s):
    p=L/(s+"-workbench.html")
    if not p.exists(): return '<li class="off"><span>%s</span><em>not built yet</em></li>'%html.escape(t)
    src=p.read_text(); sub=re.search(r'<span class="sub">(.*?)</span>',src); sub=re.sub(r"<[^>]+>","",sub.group(1)) if sub else ""
    return '<li><a href="%s-workbench.html">%s</a><em>%s</em></li>'%(s,html.escape(t),html.escape(sub))
