# column D: the pricing chain, the dispatcher and the refund policy
put("ctx", 955, 20, 265, "PriceCtx", ["restaurantId, customerId", "km: double,   busy: boolean", "coupons: List&lt;String&gt;", "lines: List&lt;OrderLine&gt;"], [])
