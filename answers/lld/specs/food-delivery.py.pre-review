put("ostate", 680, 276, 235, "OrderState",
    ["PLACED, ACCEPTED, PREPARING,", "READY, PICKED_UP, DELIVERED,", "CANCELLED, REJECTED", "NEXT: EnumMap&lt;state, Set&gt;"],
    ["canGoTo(target): boolean", "isTerminal(): boolean"], "enum")
put("pay", 680, 436, 235, "PaymentProcessor", [], ["charge(chargeId, paise): boolean", "refund(chargeId, paise)"], "interface")
put("obs", 680, 536, 235, "OrderObserver", [], ["onState(order, from)"], "interface")
