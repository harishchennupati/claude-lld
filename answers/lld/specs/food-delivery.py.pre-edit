     "liveOrders: LinkedHashSet", "lock: ReentrantLock"],
    ["reserve(want): List&lt;OrderLine&gt;", "giveBack(lines)", "enqueue / dequeue(orderId)", "stockOf(id) / menu() / liveQueue()"])
# column C: the rider, the enums, and the seams that are not pricing
put("part", 680, 20, 235, "DeliveryPartner",
