    ["restaurants / partners / orders", "carts: Map&lt;customerId, Cart&gt;", "byKey: Map&lt;key, InFlight&gt;",
     "waitingForRider: Deque&lt;orderId&gt;", "pricing: List&lt;PricingRule&gt;", "assignment / cancellation",
     "payments / demand / clock", "observers: CopyOnWriteArrayList"],
    ["configure(pricing, assign, policy, pay)", "openCart / addToCart", "placeOrder(key, customer, coupons)",
     "accept / reject / startPreparing", "markReady(id): boolean", "pickUp / deliver(id)", "cancel(id): Refund",
     "- transition(o, to): guarded", "- tryAssign(o): rank, then CAS", "- publish(o, from): after the unlock"])
