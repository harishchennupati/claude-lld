# Ride Sharing LLD workbench: problem -> twelve moves -> the class diagram -> the whole code -> follow-ups and practice.
import sys, re
sys.path.insert(0, "/Users/harishchennupati/answers/lld")
from lld_engine import *

src   = (H/"ride-sharing/Main.java").read_text()
ext   = (H/"ride-sharing/Extensions.java").read_text()
tests = (H/"ride-sharing/FailureTests.java").read_text()

def X(a, b):
    """slice Extensions.java between two '// ---- ext:' markers (b may name the ExtDemo block)"""
    marks = [m.start() for m in re.finditer(r"(?m)^// ---- ext:", ext)] + [ext.index("/** Runs every extension")]
    i = next(m for m in marks if a in ext[m:m+200])
    j = next(m for m in marks if m > i and b in ext[m:m+200])
    return ext[i:j].rstrip() + "\n"
def T(a, b):
    """slice one numbered block out of FailureTests.java"""
    return tests[tests.index(a):tests.index(b)].rstrip() + "\n"
def rail(d):
    """a plain line with no arrow head, for merging several arrows onto one track"""
    return '<path d="%s" fill="none" stroke="var(--muted)" stroke-width="1.3"/>' % d

RED = "#ff6b6b"

# ============================================================ page 01: the problem
# what the code must do: request a ride, finish a ride, and the reads as a line
pf = _D
rows = [("request a ride", 30, [("a rider taps for a car", "a place, and a tier"),
                                ("nine cells say who is near", "never a scan of the fleet"),
                                ("CLAIM the car with one CAS", "exactly one rider wins"),
                                ("a trip is born, ASSIGNED", "both phones are told")]),
        ("finish the ride",  165, [("the car stops", "the meter has the minutes"),
                                   ("price it: base + km + min", "then x surge, a wrapper"),
                                   ("record COMPLETED_UNPAID", "and free the car at once"),
                                   ("charge the card", "then, and only then, COMPLETED")])]
for lab, y, boxes in rows:
    pf += _tx(88, y+31, lab, "var(--acc)", 13)
    for k, b in enumerate(boxes):
        x = 175 + k*260
        pf += _bx(x, y, 240, 54, b[0], b[1], acc=(k == 2))
        if k < 3: pf += _ar("M%s %s H%s" % (x+240, y+27, x+260), True)
pf += _ar("M815 84 V95", dash=True) + _bx(660, 95, 310, 40, "lost the race: take the next car", "", dash=True)
pf += _tx(88, 266, "read", "var(--acc)", 13) + _tx(175, 266, "at any moment, without scanning the fleet: who is free near this pickup?  what is trip T7 doing?  what did the ride cost?", "var(--text)", 12, "start")
pf += _tx(615, 305, "hundreds of riders tap in the same second: one car is never promised to two of them, and no trip is ever left half-ended", "var(--muted)", 11.5)
P_FLOWS = _mv(1230, 320, pf)

# one evening, replayed
pe = _D + '<path d="M60 40 H1180" stroke="var(--line)" stroke-width="1.5"/>'
ev = [("18:42  Meera taps for a GO", ["9 cells hold 3 free cars", "Bilal is 25 m away, Asha 355 m",
                                      "Chen is a PREMIER: not offered", "CAS AVAILABLE -> RESERVED: Bilal"], True),
      ("18:42  Ravi taps, same second", ["he reaches for Bilal too", "compare-and-set gives him false",
                                         "no queue: Asha is next-nearest", "two riders, two cars, one instant"], False),
      ("19:09  the ride ends, 8.0 km", ["24 minutes by the injected clock", "40 + 12x8 + 1.50x24 = 172.00",
                                        "x1.5 surge = 258.00", "Bilal is free before the card"], False),
      ("19:09  the card declines", ["the trip sits at COMPLETED_UNPAID", "Bilal is AVAILABLE regardless",
                                    "the retry charges exactly once:", "the trip id is the idempotency key"], True)]
for k, (t, lines, acc) in enumerate(ev):
    x = 60 + k*290
    pe += '<circle cx="%s" cy="40" r="5" fill="var(--acc)"/>' % (x+125) + '<path d="M%s 45 V60" stroke="var(--line)"/>' % (x+125)
    pe += _card(x, 60, 250, 115, t, lines, acc=acc)
P_EX = _mv(1230, 190, pe)

REQ_HTML = '''<div class="req"><div><b>Functional requirements</b><ul>
<li>A rider asks for a car of a chosen tier at a place, and gets one or is told there is none.</li>
<li>The car sent is the nearest free one of that tier, found from a spatial index, never a scan.</li>
<li>The trip walks a fixed life: requested, assigned, arrived, started, completed &mdash; or cancelled before it starts.</li>
<li>Drivers stream their location continuously; going online and offline is instant.</li>
<li>The fare is base + per kilometre + per minute for the tier, multiplied by whatever surge is running.</li>
<li>Cancelling is free until the driver is really on his way, and costs a fee after that.</li>
<li>The rider is charged when the ride ends, and the car goes straight back into the pool.</li></ul></div>
<div><b>Non-functional requirements</b><ul>
<li>Two riders reaching for the same car at the same instant: exactly one of them gets it, and the other is not made to wait.</li>
<li>"Who is near this pickup?" touches a handful of grid cells, never the whole fleet.</li>
<li>A location ping is a field write, not an index rebuild: pings outnumber rides thirty to one.</li>
<li>An out-of-order call (end a ride that never started) throws before it writes anything.</li>
<li>Matching, pricing and the cancellation rule swap without opening the service.</li>
<li>Nothing half-done: a declined card leaves a finished ride recorded and retryable, and never strands a driver.</li>
<li>In memory, one process, no persistence (say it; a follow-up adds it).</li></ul></div></div>
'''

PROMPT = ('"Design the back end of Uber. A rider asks for a car, we find a nearby driver and send him, the ride runs, '
          'and at the end we charge for it. Two riders must never be given the same car. I want working code, not a '
          'diagram. Go."')

PROBLEM_BODY = (
 '<div class="move"><div class="prompt">' + PROMPT + '</div></div>'
 '<div class="move"><h3>The problem, in plain words</h3><p>A rider opens the app at a place and asks for a car of a '
 'certain kind. The system has to answer "who is near here" out of tens of thousands of moving cars, pick one of '
 'them, and then <i>claim</i> that car so nobody else can be given it. The ride then runs through a fixed sequence '
 '&mdash; the driver is assigned, he arrives, the rider gets in, the car stops &mdash; and each of those steps is '
 'only legal from the step before it. At the end the fare comes from how far and how long the car drove, times '
 'whatever surge is running, and the rider is charged. Cancelling is allowed, but only before the meter starts, and '
 'after the driver has really set off it costs something. The one thing that must always be true: a car is promised '
 'to exactly one rider. Thousands of riders tap at the same instant, and two of them will sometimes reach for the '
 'same car in the same microsecond.</p></div>'
 '<div class="move"><h3>What is expected of you in the hour</h3><p>Not a diagram: classes that compile and run, with '
 'a <code>main</code> that sends a car, runs the ride, prints the fare, and then fires many threads at one car to '
 'show that only one of them gets it. The interviewer is watching for, in this order: the questions you ask before '
 'typing (how big is the fleet, and is straight-line distance good enough, are the first two); which classes exist '
 'and which one owns a driver\'s status; one ride end to end; what happens when two requests reach the same car; '
 'where the rules that will change &mdash; who to send, what to charge &mdash; live, so a new one is a new class and '
 'not an edit; and what the system looks like when the card declines <i>after</i> the ride is over. Then the twists: '
 'the driver who ignores the request, starvation, pooling, ratings, a denser city, persistence.</p></div>'
 '<div class="move"><h3>What the code must do</h3></div>' + P_FLOWS +
 '<div class="move"><h3>Questions to ask back, and what each answer decides</h3></div>'
 '<div class="move"><table class="ask"><tr><th>Ask</th><th>Assume this when they say "you decide"</th><th>What the answer decides</th></tr>'
 '<tr><td>One city or the world, and how many cars online?</td><td>One city, tens of thousands of cars</td><td>A flat grid index rather than a sharded geo-service (moves 5, 8)</td></tr>'
 '<tr><td>Is straight-line distance good enough, or must it be a real route?</td><td>Straight line for matching, the driven distance for the fare</td><td>Haversine now, a routing service as a named seam (moves 3, 5)</td></tr>'
 '<tr><td>One rider at a time, greedy, or batched dispatch over a window?</td><td>Greedy, nearest free car</td><td>A one-method matching rule, swappable for a batch solver (move 3)</td></tr>'
 '<tr><td>Can the driver decline, or does the assignment stick?</td><td>It sticks for now</td><td>Whether the claim is a lease with a deadline (moves 6, 12)</td></tr>'
 '<tr><td>Are surge, coupons and tolls in scope?</td><td>Surge yes, the rest named</td><td>Pricing as a rule that can be wrapped, not a formula with flags (move 3)</td></tr>'
 '<tr><td>What happens if the card declines after the ride?</td><td>The ride still happened; retry the money</td><td>A COMPLETED_UNPAID state and the order at the end (move 6)</td></tr>'
 '<tr><td>Payments, ratings, notifications &mdash; real or stubbed?</td><td>Stubbed behind interfaces</td><td>Observers and an injected gateway, so tests can make them fail (moves 3, 9)</td></tr>'
 '<tr><td>One process and in memory, or a database and many servers?</td><td>One process, in memory</td><td>No repository yet; the compare-and-set becomes SQL later (move 12)</td></tr></table></div>'
 '<div class="move"><h3>What it must do, and what it must survive</h3></div>' + REQ_HTML +
 '<div class="move"><h3>One evening, replayed</h3></div>' + P_EX +
 '<div class="grade"><b>Say before typing:</b> one city, tens of thousands of cars, one process, in memory; straight-line '
 'distance decides who is near, the driven distance decides the fare; money is integer paise; a driver\'s status is the '
 'only cell two threads fight over, so it is a compare-and-set and not a lock; a ride cannot be un-driven, so the ride is '
 'committed before the card is charged. Named as out of scope: pooling, ratings, batched dispatch, a real routing service, '
 'persistence &mdash; each is a follow-up on page 05.</div>')

# ============================================================ page 02: the twelve moves
MV = {}
# move 1: nouns with state -> classes
m1 = _D + '<rect x="20" y="20" width="1190" height="44" rx="6" fill="var(--bg3)" stroke="var(--line)"/>'
m1 += _tx(615, 47, "a RIDER asks for a CAR at a PLACE; a DRIVER has a STATUS and a LOCATION; a TRIP has a LIFE and a FARE; a RULE picks the car", "var(--text)", 12.5)
for x, w, t, sub, acc in [(30, 170, "Rider", "an id and a name", 0), (228, 190, "Driver", "status + location, both move", 1),
                          (446, 180, "Trip", "a life, and a fare", 1), (656, 170, "Location", "two numbers, frozen", 0),
                          (856, 170, "Matching rule", "no state: an interface", 0), (1056, 150, "ETA", "a question, not state", 0)]:
    m1 += _bx(x, 110, w, 46, t, sub, acc=bool(acc), dash=not acc) + _ar("M%s 64 V110" % (x + w/2))
m1 += _tx(615, 190, "solid = it has state of its own, so it becomes a class.   dashed = no state: an id, a frozen value, an interface, or a question", "var(--muted)", 11)
MV[1] = _mv(1230, 205, m1)

# move 2: verbs -> the class that owns the state they touch
m2 = _D
for k, (verb, cls, meth) in enumerate([("say who is near this place", "DriverIndex  (owns the grid)", "index.nearby(pickup)"),
                                       ("claim one car", "Driver  (owns his own status)", "driver.reserve()   // one CAS"),
                                       ("run a ride's life", "Trip  (owns status + the table)", "trip.transitionTo(ARRIVED)"),
                                       ("order the whole thing", "RideService  (owns the flow)", "svc.requestRide(rider, ...)")]):
    y = 24 + k*56
    m2 += _bx(30, y, 330, 44, verb, "the verb") + _ar("M360 %s H430" % (y+22), True)
    m2 += _bx(430, y, 400, 44, cls, "the class whose state it touches", acc=True) + _ar("M830 %s H900" % (y+22), True)
    m2 += _bx(900, y, 300, 44, meth, "the method")
m2 += _tx(615, 255, "a verb whose state is spread over two classes goes to the class that sees both: that class becomes the orchestrator", "var(--muted)", 11)
m2 += _tx(615, 274, "and notice what is NOT a verb on the service: \"set the driver's status\". Only the driver may do that, and only with a compare-and-set", "var(--muted)", 11)
MV[2] = _mv(1230, 290, m2)

# move 3: rules that change -> one-method interfaces handed in
m3 = _D + _bx(30, 90, 220, 90, "RideService", "configure(four rules)", acc=True)
for k, (t, sub, impl) in enumerate([("MatchingStrategy", "which car gets the ride", "NearestDriver / LongestIdle / EtaMatching"),
                                    ("PricingStrategy", "what the ride costs", "NormalPricing, and Surge WRAPPING it"),
                                    ("CancellationPolicy", "what calling it off costs", "StandardCancellation, or free always"),
                                    ("TripObserver", "who hears that a trip moved", "PushNotifier, RatingBook, analytics")]):
    y = 24 + k*56
    m3 += _ar("M250 135 H330 V%s H400" % (y+22), True, True) + _bx(400, y, 300, 44, t, sub, dash=True)
    m3 += _bx(760, y, 420, 44, impl, "the classes that can be handed in") + _ar("M760 %s H700" % (y+22))
m3 += _tx(615, 262, "dashed lavender = handed in. The service never builds a rule, so a new way of matching is a new class and one changed line", "var(--muted)", 11)
m3 += _tx(615, 281, "and one rule WRAPS another: SurgePricing(base) multiplies whatever the base charged, so coupons and tolls stack instead of becoming flags", "var(--acc)", 11)
MV[3] = _mv(1230, 295, m3)

# move 4: the gap, and one owner -- here one CELL, settled by a compare-and-set
m4 = _D + _bx(30, 30, 190, 44, "Meera's phone", "reads Bilal: AVAILABLE") + _bx(30, 110, 190, 44, "Ravi's phone", "reads Bilal: AVAILABLE")
m4 += _bx(350, 70, 190, 44, "Bilal.status", "AVAILABLE", acc=True)
m4 += _ar("M220 52 H350 V70") + _ar("M220 132 H350 V114") + _tx(285, 40, "read", "var(--muted)", 10.5) + _tx(285, 160, "read", "var(--muted)", 10.5)
m4 += '<rect x="580" y="20" width="290" height="140" rx="6" fill="none" stroke="%s" stroke-dasharray="4 3"/>' % RED
m4 += _tx(725, 45, "the gap", RED, 12) + _tx(725, 70, "both read AVAILABLE, both write", RED, 11) + _tx(725, 90, "one car, two riders, two trips", RED, 11)
m4 += _tx(725, 130, "fix: read and write as ONE step", "var(--text)", 11)
m4 += _bx(900, 40, 300, 100, "AtomicReference&lt;DriverStatus&gt;", "compareAndSet(AVAILABLE, RESERVED)", acc=True)
m4 += _tx(1050, 165, "one cell, one owner: the driver", "var(--muted)", 10.5)
m4 += _tx(1050, 185, "no lock: one instruction decides", "var(--muted)", 10.5)
m4 += _tx(615, 205, "the loser is not queued and does not fail: he drops that car and reaches for the next-nearest one, microseconds later", "var(--muted)", 11)
MV[4] = _mv(1230, 220, m4)

# move 5: each collection, its question, its O(1) shape
m5 = _D
for k, (q, shape, cost) in enumerate([("who is free near this pickup?", "Map&lt;cell, Set&lt;Driver&gt;&gt;, nine cells read", "O(9 + c)"),
                                      ("where is driver D1 right now?", "a volatile Location field on the Driver", "O(1)"),
                                      ("what is trip T7 doing?", "Map&lt;tripId, Trip&gt;", "O(1)"),
                                      ("is this move of the trip legal?", "EnumMap&lt;TripStatus, EnumSet&lt;TripStatus&gt;&gt;", "O(1)"),
                                      ("what does a GO cost per km?", "EnumMap&lt;VehicleType, long[3]&gt;", "O(1)")]):
    y = 20 + k*50
    m5 += _bx(30, y, 360, 40, q, "the question") + _ar("M390 %s H450" % (y+20), True)
    m5 += _bx(450, y, 520, 40, shape, "the shape", acc=True) + _ar("M970 %s H1030" % (y+20), True) + _bx(1030, y, 170, 40, cost, "")
m5 += _tx(615, 290, "nothing here scans the fleet and nothing recomputes a state from history: every question above is one hash lookup, or nine of them", "var(--muted)", 11)
MV[5] = _mv(1230, 305, m5)

# move 6: the state machine and the TWO critical orders
m6 = _D
st = [("REQUESTED", "no car yet"), ("ASSIGNED", "a car is held"), ("ARRIVED", "at the kerb"),
      ("IN_PROGRESS", "the meter runs"), ("COMPLETED_UNPAID", "the ride is a fact"), ("COMPLETED", "the money moved")]
for k, (t, sub) in enumerate(st):
    x = 20 + k*200
    m6 += _bx(x, 20, 175, 44, t, sub, acc=(k in (2, 4)))
    if k < 5: m6 += _ar("M%s 42 H%s" % (x+175, x+200), True)
for cx in (107, 307, 507):
    m6 += rail("M%s 64 V95 H520" % cx)
m6 += _ar("M520 95 V120", True) + _bx(420, 120, 200, 44, "CANCELLED", "only from the first three", acc=True)
m6 += _tx(660, 148, "and never once the meter is running: you cannot un-drive a ride", "var(--muted)", 11, "start")
m6 += _card(20, 190, 590, 130, "the order when a car is claimed",
            ["1 ask the index: nine cells, no lock at all", "2 the rule picks one: it only proposes",
             "3 CLAIM it: compareAndSet(AVAILABLE, RESERVED)", "4 only now make the trip and tell the phones",
             "nothing is written until the claim succeeds"], acc=True)
m6 += _card(620, 190, 590, 130, "the order when the ride ends -- the other way round",
            ["1 price it: pure, and it may throw", "2 record COMPLETED_UNPAID: the ride happened",
             "3 free the car BEFORE the money is touched", "4 charge the card, outside every lock",
             "a decline leaves the trip unpaid and retryable"], acc=True)
m6 += _tx(615, 340, "two critical steps, two shapes: claim before you write when the thing can be undone, commit before you charge when it cannot", "var(--muted)", 11)
MV[6] = _mv(1230, 355, m6)

# move 7: what is actually serialised, and four hundred riders at the same instant
m7 = _D + _card(30, 20, 540, 150, "the contended part: one CPU instruction",
                ["compareAndSet on one driver's status: ~20 ns", "no lock is taken and no thread ever blocks",
                 "the per-trip monitor: a table lookup and", "three field writes, about 0.3 microseconds",
                 "contended by one rider and one driver"], acc=True)
m7 += _ar("M570 95 H640", True) + _tx(605, 85, "no lock", "var(--acc)", 10.5)
m7 += _card(640, 20, 560, 150, "everything else runs fully in parallel",
            ["the nine-cell read: about 40 cars, ~2 us", "the min-scan for the nearest: 40 distances",
             "the card payment: about 500 ms, no lock held", "the push notifications: ~50 ms, afterwards",
             "the person choosing a destination: seconds"])
m7 += _tx(615, 200, "four hundred riders tap in the same second", "var(--text)", 12)
for k in range(10):
    x = 30 + k*118
    m7 += _bx(x, 215, 106, 40, "rider %d" % (k+1), "0 retries" if k < 9 else "1 retry, 2 us", acc=(k == 9))
m7 += _tx(615, 283, "nobody queues. The one rider who reached for a car another rider had already won is the only one who does extra work,", "var(--muted)", 11)
m7 += _tx(615, 301, "and that work is one failed instruction and then the second-nearest car, about two microseconds later", "var(--muted)", 11)
MV[7] = _mv(1230, 315, m7)

# move 8: the arithmetic, then the ladder
m8 = _D + '<rect x="20" y="20" width="560" height="185" rx="6" fill="var(--bg3)" stroke="var(--line)"/>' + _tx(300, 42, "one compare-and-set per ride: is it a bottleneck?", "var(--text)", 12)
for k, l in enumerate(["60,000 cars online, 400 ride requests a second at peak",
                       "one request: 9 cell lookups + ~40 distances, about 2 us",
                       "400 x 2 us = 800 us of CPU a second: 0.08% of one core",
                       "pings: 15,000 a second, but only ~500 cross a cell",
                       "the contended cell is one driver's status, for ~20 ns"]):
    m8 += _tx(35, 66 + k*24, l, "var(--muted)", 11, "start")
m8 += _tx(890, 42, "the upgrade ladder, in the order you would climb it", "var(--text)", 12)
for k, (t, sub) in enumerate([("1 keep the card and the push outside everything", "already done: the money runs with no lock held"),
                              ("2 finer cells where the city is dense", "a quadtree or a geohash: the index is an interface"),
                              ("3 shard by zone, across processes", "UPDATE driver SET status='RESERVED' WHERE status='AVAILABLE'")]):
    m8 += _bx(600, 58 + k*50, 600, 42, t, sub, acc=(k == 0))
MV[8] = _mv(1230, 220, m8)

# move 9: what can go wrong, and the test for each
m9 = _D
for k, (bad, fix) in enumerate([("two riders, one car", "compare-and-set; test 1: 200 riders, 40 cars, exactly 40 trips"),
                                ("end a trip that never started", "one legal-edge table; test 3: it throws and writes nothing"),
                                ("the card declines after the ride", "COMPLETED_UNPAID + retry; test 6: the money moves once"),
                                ("a cancelled ride strands the car", "every exit frees the driver; test 4: AVAILABLE again"),
                                ("the push gateway is down", "publish after the move, in a try/catch; test 7: it throws"),
                                ("the driver drives off, or logs off", "the ping rewrites the grid; test 8: found in the new cell only")]):
    y = 18 + k*42
    m9 += _bx(30, y, 300, 38, bad, "") + _ar("M330 %s H380" % (y+19), True) + _bx(380, y, 820, 38, fix, "", acc=True)
m9 += _tx(615, 292, "every claim this design makes has a failure test: FailureTests.java runs eight blocks and must print ALL PASS", "var(--muted)", 11)
MV[9] = _mv(1230, 305, m9)

# move 10: the patterns, named after the fact
cols10 = [("pattern", 12), ("born in", 210), ("the line in the code", 300), ("what it buys", 840)]
rows10 = [[("Strategy", "var(--text)"), ("move 3", None), ("MatchingStrategy, PricingStrategy, CancellationPolicy: one method each", None), ("a new rule is a new class, not an edit", None)],
          [("Decorator", "var(--text)"), ("move 3", None), ("new SurgePricing(base, surge)  --  and a coupon wraps that", None), ("surge, coupons and tolls stack, not flags", None)],
          [("Observer", "var(--text)"), ("move 4", None), ("publish(trip, from, to) after the move, inside a try/catch", None), ("the phones hear; the ride never waits", None)],
          [("State (as a table)", "var(--text)"), ("move 6", None), ("EnumMap&lt;TripStatus, EnumSet&gt;, checked before any write", None), ("an illegal move cannot happen", None)],
          [("Facade", "var(--text)"), ("move 2", None), ("RideService: request, arrive, start, end, cancel, and nothing else", None), ("the order of operations lives in one place", None)],
          [("Singleton", "var(--muted)"), ("not here", None), ("the service is handed to its callers; nothing calls getInstance()", "var(--muted)"), ("a test builds a fresh RideService", "var(--muted)")],
          [("Factory", "var(--muted)"), ("not yet", None), ("VehicleType is an enum and the rate table is already the registry", "var(--muted)"), ("it earns the name when tiers come from config", "var(--muted)")],
          [("Builder", "var(--muted)"), ("never", None), ("a Trip has six required fields and not one optional one", "var(--muted)"), ("a pattern without a move is decoration", "var(--muted)")]]
m10 = _D + _table(20, 20, cols10, rows10, rowh=30, widths=1190)
m10 += _tx(615, 305, "name a pattern only after the move that produced it; then every name has a one-sentence defence", "var(--muted)", 11)
MV[10] = _mv(1230, 320, m10)

# move 11: SOLID as a check on the moves
cols11 = [("", 12), ("the rule, in plain words", 50), ("from", 440), ("the line that shows it", 560)]
rows11 = [[("S", "var(--acc)"), ("one reason to change per class", None), ("move 2", None), ("Index: where cars are. Trip: the life. Service: the order. A rule: one rule.", None)],
          [("O", "var(--acc)"), ("new behaviour is a new class, not an edited one", None), ("move 3", None), ("LongestIdleMatching is a new file plus one line at the call site", None)],
          [("L", "var(--acc)"), ("any implementation drops in; nobody checks which", None), ("move 3", None), ("SurgePricing IS a PricingStrategy and HOLDS one, so it slots in anywhere", None)],
          [("I", "var(--acc)"), ("small interfaces: one method each", None), ("move 3", None), ("MatchingStrategy, PricingStrategy, CancellationPolicy, TripObserver, Clock", None)],
          [("D", "var(--acc)"), ("depend on interfaces; implementations are handed in", None), ("moves 3, 6", None), ("svc.configure(matching, pricing, cancellation, payments);  svc.setClock(...)", None)]]
m11 = _D + _table(20, 20, cols11, rows11, rowh=34, widths=1190)
m11 += _tx(615, 250, "SOLID is not a list to recite; it is the check that the moves did their job, one line each", "var(--muted)", 11)
MV[11] = _mv(1230, 265, m11)

# move 12: every twist is one of five moves
m12 = _D
for k, (t, sub, fix, sub2, mv) in enumerate([
        ("a new rule", "shortest ETA, batched dispatch", "a new class behind MatchingStrategy plus one line", "", "move 3"),
        ("someone new wants to know", "ratings, analytics, receipts", "one more observer; the trip and the CAS do not change", "", "move 4"),
        ("a new step in a life", "the driver declines, a no-show", "one more edge in the table, and the claim becomes a lease", "", "move 6"),
        ("a new invariant across things", "one car, several riders: pool", "the same claim, then a fare divided so the shares sum to it", "", "moves 4 + 6"),
        ("state that must outlive it", "persist it; two servers", "the compare-and-set becomes a conditional UPDATE:", "UPDATE driver SET status='RESERVED' WHERE id=? AND status='AVAILABLE'", "moves 5 + 12")]):
    y = 24 + k*54
    m12 += _bx(30, y, 330, 44, t, sub) + _ar("M360 %s H420" % (y+22), True) + _bx(420, y, 660, 44, fix, sub2, acc=True) + _tx(1150, y+27, mv, "var(--muted)", 11)
m12 += _tx(615, 312, "for all five the service, the trip machine and the tests do not change; that is the test that the derivation was right", "var(--muted)", 11)
MV[12] = _mv(1230, 325, m12)

MOVES = [
("Move 1: underline the nouns. Every noun with its own state becomes a class.",
 "Reading the paragraph again: a <b>rider</b> asks for a <b>car</b> at a <b>place</b>; a <b>driver</b> has a "
 "<b>status</b> and a <b>location</b>; a <b>trip</b> has a <b>life</b> and a <b>fare</b>; a <b>rule</b> picks the "
 "car. A driver has two fields that move on their own &mdash; where he is, and whether he is free &mdash; so he is a "
 "class, and the most interesting one here. A trip has a status, a fare and a set of timestamps: a class. A rider "
 "has an id and a name and nothing that moves, so it is a record and only the id ever reaches a payment. A location "
 "is two numbers that never change once taken: a record with one method on it, the distance to another location. A "
 "matching rule has no state at all &mdash; it is a decision &mdash; so it is an interface. And an ETA is not a "
 "field to keep up to date: it is a question you answer when somebody asks, from a location that is already there.", 1),
("Move 2: for every verb, ask which class holds the state it touches. That class gets the method.",
 "\"Say who is near this place\" touches the grid of cars, so it belongs to the thing that owns the grid: "
 "<code>index.nearby(pickup)</code>. \"Claim one car\" touches exactly one field on exactly one driver, so it belongs "
 "to the driver: <code>driver.reserve()</code>. \"Run a ride's life\" touches the trip's status and the table of "
 "legal moves, so it belongs to the trip: <code>trip.transitionTo(ARRIVED)</code>. \"Order the whole thing\" touches "
 "all three at once, and only one class sees all three, so <code>RideService</code> is the orchestrator. Notice what "
 "is deliberately <i>not</i> a method on the service: setting a driver's status. If the service could write that "
 "field, two service calls could write it in the same microsecond and both think they won. Only the driver may "
 "change his own status, and only through a compare-and-set.", 2),
("Move 3: every rule the interviewer can change mid-round goes behind an interface and is handed in.",
 "Which car to send will change: nearest today, shortest ETA when routing arrives, longest-idle when the ops team "
 "complains about starvation, a batch solver when somebody reads a paper. What to charge will change every week. "
 "What a cancellation costs will change the first time a city regulator calls. Who gets told will grow: the rider's "
 "phone, the driver's app, ratings, analytics. Each becomes a one-method interface the service is <i>given</i> in "
 "<code>configure()</code> and never builds. This is where the patterns come from, not the other way round: a "
 "swappable rule behind an interface is <b>Strategy</b>; a rule that wraps another rule and adds to it is "
 "<b>Decorator</b> &mdash; and here it is the one that matters, because <code>SurgePricing</code> holds a "
 "<code>PricingStrategy</code> and multiplies whatever it charged, so a coupon wraps the surge and a toll wraps the "
 "coupon, and nobody ever adds a fifth flag to one fare method. A service that announces \"a trip moved\" without "
 "knowing what a phone is, is <b>Observer</b>. The spatial index is in the same family but is not a rule: it is a "
 "collaborator behind an interface, so a grid today and a quadtree next year is one line at the call site.", 3),
("Move 4: state that many callers change at the same time gets one owner and one atomic step.",
 "Two riders tap at the same instant and the index hands both of them the same nearest car. Both read his status as "
 "AVAILABLE, both decide he is theirs, and both write: one car, two riders, two trips, and a very angry driver. So "
 "reading the status and writing it must be a single step. The usual answer is a lock, and here the usual answer is "
 "wrong in an interesting way: the shared thing is not a big structure, it is <i>one field on one driver</i>. So the "
 "field becomes an <code>AtomicReference</code> and the claim becomes "
 "<code>compareAndSet(AVAILABLE, RESERVED)</code> &mdash; one hardware instruction, about twenty nanoseconds, and "
 "exactly one thread gets <code>true</code>. A global matching lock would have serialised every rider in the city to "
 "protect a collision that happens to two of them; this serialises only the two who actually collided. And the loser "
 "is not punished: he gets <code>false</code>, drops that car from his own list, and takes the next-nearest one. "
 "Anything that only listens &mdash; the push notification, the rating prompt &mdash; is called after the state has "
 "already moved, never before.", 4),
("Move 5: for each collection, ask what question is asked of it, and pick the shape that answers in O(1).",
 "\"Who is free near this pickup?\" is the one that decides the design. Sixty thousand cars in a list is a scan, so "
 "location gets an index: round the latitude and longitude to a cell about a kilometre across and keep a set of cars "
 "per cell. A read is the pickup's cell plus its eight neighbours &mdash; nine bucket lookups, whatever the fleet "
 "size. \"Where is driver D1?\" is a volatile field on the driver, written by the ping path and read by matching, "
 "with no lock in either direction. \"What is trip T7 doing?\" is a map from id to trip. \"Is this move legal?\" is "
 "an <code>EnumMap</code> from status to the set of statuses it may go to, which is the whole lifecycle in six lines. "
 "\"What does a GO cost per kilometre?\" is an <code>EnumMap</code> from tier to a rate triple, instead of an "
 "if-chain that grows a branch per tier. The one subtlety: the index is only rewritten when a car actually crosses a "
 "cell boundary, which at city speed is about once every two minutes, so the fifteen thousand pings a second cost "
 "one volatile write each and almost nothing else.", 5),
("Move 6: anything with a life cycle is a state machine, and the ORDER of operations is part of the design.",
 "A trip is REQUESTED, then ASSIGNED, then ARRIVED, then IN_PROGRESS, then COMPLETED_UNPAID, then COMPLETED; "
 "CANCELLED is reachable from the first three and never after the meter starts, because you cannot un-drive a ride. "
 "Every legal move is one row in one table and <code>transitionTo</code> is the only writer, and it checks the table "
 "<i>before</i> it touches a field, so ending a ride that never started throws and leaves the trip exactly as it "
 "was. Writing the states down forces the two order questions, and they have opposite answers. Claiming a car: ask "
 "the index, let the rule pick, and <i>claim</i> before anything is written, because a claim that fails must leave no "
 "trace. Ending a ride: the ride is already a fact, so record it first, free the car second, and only then call the "
 "card &mdash; outside every lock, with the trip id as the idempotency key. A declined card leaves the trip at "
 "COMPLETED_UNPAID with the driver already back in the pool, and <code>retryPayment</code> finishes it later. That "
 "state is not a fudge: it is the honest name for \"the ride happened and the money has not\".", 6),
("Move 7: yes, two riders reaching for one car are serialised. Ask for how long, and what else is.",
 "The question you will be asked, and should ask yourself: have you now made dispatch one-at-a-time? No, and this is "
 "the part worth being precise about. There is no lock anywhere in the matching path. The nine-cell read, the "
 "distance scan over about forty cars, the choice, the trip object, the notifications &mdash; all of it runs fully in "
 "parallel across every rider in the city. The only mutual exclusion is one compare-and-set on one driver's status, "
 "about twenty nanoseconds, and it only ever involves the two riders who reached for the same car. The one lock in "
 "the system is the per-trip monitor on <code>transitionTo</code>, held for a table lookup and three field writes, "
 "about a third of a microsecond, and contended by exactly two people: that trip's rider and that trip's driver. "
 "Everything slow is outside all of it: the card payment at around five hundred milliseconds, the push notification "
 "at fifty. So when four hundred riders tap in the same second, none of them waits for another, and the one who "
 "was a microsecond late pays for it with a failed instruction and a second-nearest car.", 7),
("Move 8: say the arithmetic, then name the ladder.",
 "Sixty thousand cars online and four hundred ride requests a second at peak. A request is nine cell lookups and "
 "about forty haversine calculations: roughly two microseconds of CPU. Four hundred of those is eight hundred "
 "microseconds a second, which is eight hundredths of one per cent of a single core. The write path is the bigger "
 "number and the cheaper one: sixty thousand cars pinging every four seconds is fifteen thousand pings a second, but "
 "a car at city speed crosses a one-kilometre cell about every two minutes, so only about five hundred of those "
 "fifteen thousand touch the grid at all. Then the ladder, in the order you would climb it: keep the payment and the "
 "notification outside everything, which this code already does; when one downtown cell holds four thousand cars, go "
 "finer there &mdash; a quadtree, a geohash prefix or S2 cells &mdash; which is a new class because the index is an "
 "interface; and beyond one process, shard by zone and let the driver's status become a database row, where the "
 "claim is <code>UPDATE driver SET status='RESERVED' WHERE id=? AND status='AVAILABLE'</code> and \"one row updated\" "
 "means you won. That conditional UPDATE is the same compare-and-set, done by the database.", 8),
("Move 9: list what can go wrong, and write the test for each before the interview is over.",
 "Two riders reaching for one car (exactly one trip, and the loser gets another car). An out-of-order call, such as "
 "ending a ride that never started (it throws, and the trip is untouched afterwards). The card declining after the "
 "ride is over (the trip is recorded, the driver is free, and the retry moves the money exactly once). A cancelled "
 "ride that forgets to give the car back (every exit path releases the driver, or the fleet quietly drains over a "
 "day). The push gateway down (publish after the state has moved, inside a try/catch). A driver who drives across "
 "the city or logs off (the ping rewrites the grid on a cell crossing, and going offline removes him entirely, so a "
 "rider at the old place is told there is no car rather than being sent one). Each of these is a few lines in "
 "FailureTests.java; a design that cannot show its tests is a claim.", 9),
("Move 10: now, and only now, name the patterns. Each one is the result of a move.",
 "Every pattern on this page came out of a move, which is why each can be defended in one sentence. Strategy is move "
 "3: who to send, what to charge and what a cancellation costs are rules that will change, so each sits behind a "
 "one-method interface the service is handed. Decorator is the same move's wrapper: <code>SurgePricing</code> is a "
 "<code>PricingStrategy</code> that holds a <code>PricingStrategy</code>, so surge, a coupon and a toll are three "
 "independent wrappers instead of three flags inside one method. Observer is move 4's rule that a phone must never be "
 "in front of the state change. State is move 6, but as a <i>table</i> rather than a class per state: the whole "
 "lifecycle is six lines you can read at once, and a class per state would buy nothing here because a trip's states "
 "carry no behaviour of their own &mdash; when they do, that is when you split them. Facade is move 2: the service "
 "is the one door, and the order of operations lives behind it. Singleton earned nothing: the service is handed to "
 "its callers, so a test builds a fresh one. Factory is \"not yet\" &mdash; the tier is an enum and the rate table is "
 "already the registry, and it earns the name the day tiers arrive as strings from configuration. Builder is never, "
 "on this problem: a trip has six required fields and no optional ones. A pattern without a move behind it is "
 "decoration.", 10),
("Move 11: run SOLID as a check on the moves, one line each.",
 "SOLID is not a list to recite; it is the check that the moves did their job. S: one reason to change per class, "
 "which move 2 gave you &mdash; the index changes when the spatial shape changes, the trip when the lifecycle "
 "changes, a rule when that rule changes, and the service only when the order of operations changes. O: new "
 "behaviour is a new class and one changed line, never an opened one (<code>LongestIdleMatching</code> is a new "
 "file). L: any implementation drops in and nothing asks which one it got &mdash; and the sharpest case is "
 "<code>SurgePricing</code>, which is a pricing rule <i>and</i> holds one, so it can wrap the base, or a coupon, or "
 "another surge. I: five interfaces with one method each, so a fake for a test is a lambda &mdash; the failure tests "
 "hand in a payment processor that is three lines long. D: the service depends on interfaces and is handed the "
 "implementations, which is exactly why a test can give it a card that always declines and a clock that says the "
 "ride took twenty-four minutes.", 11),
("Move 12: every twist the interviewer adds is one of five moves. Say which before you type.",
 "A new rule (shortest ETA, longest-idle, batched dispatch over a five-second window) is a new class behind "
 "<code>MatchingStrategy</code> plus one line at the composition root. Someone new who wants to know (ratings, "
 "analytics, receipts, a fraud check) is one more observer; the trip machine and the compare-and-set do not change. "
 "A new step in a life (the driver declines, the rider never shows up) is one more edge in the table plus turning "
 "the claim into a lease with a deadline: hold the car for fifteen seconds, release it if nobody taps accept, and "
 "offer it to the next candidate. A new invariant across things (a pooled ride: one car, three riders) is the same "
 "claim followed by a fare divided so the shares add up to the fare to the paise. State that must outlive the "
 "process (persist it; two servers) is the trip behind a repository and the claim as "
 "<code>UPDATE driver SET status='RESERVED' WHERE id=? AND status='AVAILABLE'</code>, which is the database doing "
 "the identical atomic step. For all five the service, the trip machine and the tests do not change; that is the "
 "test that the derivation was right. Page 05 has the code for each.", 12),
]
DERIVATION_LEAD = ("Run these on any LLD (parking lot, elevator, BookMyShow) and the class diagram, the concurrency, the "
 "tests, the patterns, SOLID and the answer to every twist fall out in that order; nothing is chosen up front, and nothing "
 "is named before the move that produced it. On this problem move 4 is the one that pays: the shared thing is a single "
 "field on a single driver, so the honest answer is a compare-and-set and not a lock, and the whole of dispatch stays parallel.")

