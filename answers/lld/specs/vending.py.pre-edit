# Vending machine LLD workbench: problem -> twelve moves -> the class diagram -> the whole code -> follow-ups and practice.
import sys, re
sys.path.insert(0, "/Users/harishchennupati/answers/lld")
from lld_engine import *

src   = (H/"vending/Main.java").read_text()
ext   = (H/"vending/Extensions.java").read_text()
tests = (H/"vending/FailureTests.java").read_text()

def X(a, b):
    """slice Extensions.java between two '// ---- ext:' markers (b may name the ExtDemo block)"""
    marks = [m.start() for m in re.finditer(r"(?m)^// ---- ext:", ext)] + [ext.index("/** Runs every extension")]
    i = next(m for m in marks if a in ext[m:m+200])
    j = next(m for m in marks if m > i and b in ext[m:m+200])
    return ext[i:j].rstrip() + "\n"
def T(a, b):
    """slice one numbered block out of FailureTests.java"""
    return tests[tests.index(a):tests.index(b)].rstrip() + "\n"

RED = "#ff6b6b"

# ============================================================ page 01: the problem
pf = _D
rows = [("buy", 30, [("coins go into the slot", "they sit in escrow, not ours yet"),
                     ("press A1: prove the sale", "stock, price and change, all proven"),
                     ("the motor turns", "the one act that cannot be undone"),
                     ("commit: stock, float, tray", "item and change in the tray")]),
        ("coin return", 165, [("press coin return", "any time before the item drops"),
                              ("the escrow, coin for coin", "the same coins, not the same total"),
                              ("into the tray", "the machine keeps nothing"),
                              ("back to idle", "ready for the next customer")])]
for lab, y, boxes in rows:
    pf += _tx(88, y+31, lab, "var(--acc)", 13)
    for k, b in enumerate(boxes):
        x = 150 + k*270
        pf += _bx(x, y, 250, 54, b[0], b[1], acc=(k == 1))
        if k < 3: pf += _ar("M%s %s H%s" % (x+250, y+27, x+270), True)
pf += _ar("M545 84 V95", dash=True) + _bx(330, 95, 430, 40, "sold out, too little, or no change: nothing moves", "", dash=True)
pf += _tx(88, 266, "read", "var(--acc)", 13) + _tx(150, 266, "at any moment, without counting anything: how many are left in A1?  what is the float worth?  could you make change for a fifty?", "var(--text)", 12, "start")
pf += _tx(615, 305, "two panels can press at the same instant: one unit is sold once, and every paise that goes in comes out as change, a refund, or the float", "var(--muted)", 11.5)
P_FLOWS = _mv(1230, 320, pf)

pe = _D + '<path d="M60 40 H1180" stroke="var(--line)" stroke-width="1.5"/>'
ev = [("17:02  Rs 30 for a Dairy Milk", ["escrow: Rs 20 + Rs 10 = Rs 30", "Rs 5 change is proven first",
                                         "the motor turns, then stock 3 -> 2", "float 100 -> 125; bar + Rs 5 out"], True),
      ("17:05  Rs 10 for a Rs 35 Coke", ["Rs 25 short, so nothing happens", "not one paise of the escrow moves",
                                          "coin return gives that Rs 10 back"], False),
      ("17:09  Rs 40 in, float is thin", ["change due Rs 15; float: one Rs 10", "it cannot be made, so it is refused",
                                           "Rs 40 to the tray, stock still 3"], False),
      ("17:30  two panels, one Lays left", ["both read '1 left' at one instant", "the lock lets exactly one through",
                                             "one item out; the loser gets Rs 30", "A1 hits 0 and the pager fires"], True)]
for k, (t, lines, acc) in enumerate(ev):
    x = 60 + k*290
    pe += '<circle cx="%s" cy="40" r="5" fill="var(--acc)"/>' % (x+125) + '<path d="M%s 45 V60" stroke="var(--line)"/>' % (x+125)
    pe += _card(x, 60, 250, 115, t, lines, acc=acc)
P_EX = _mv(1230, 190, pe)

REQ_HTML = '''<div class="req"><div><b>Functional requirements</b><ul>
<li>Coins go in one at a time and sit in escrow until a sale commits.</li>
<li>Press a slot code: sell when there is stock, the money covers the price, and exact change can be made.</li>
<li>Refuse with a reason &mdash; unknown code, sold out, not enough money &mdash; without touching the money.</li>
<li>Refund everything when exact change cannot be made from the float plus the escrow.</li>
<li>Coin return any time before the item drops: the same coins back, not the same total.</li>
<li>The item and its change land in a tray the customer empties.</li>
<li>Operator: restock a column, refill the coin float, take the machine out of service.</li>
<li>The price is a rule that can change (happy hour) without touching the machine.</li></ul></div>
<div><b>Non-functional requirements</b><ul>
<li>Two panels at the same instant: a unit is sold once, and no paise appears or disappears.</li>
<li>Money is exact: integer paise, never a <code>double</code>.</li>
<li>"How many are left?" and "what is the float worth?" are O(1), never a count of anything.</li>
<li>The price rule and the change algorithm are swappable without opening the machine.</li>
<li>One source of truth for stock and for cash: the machine's slots and coin box, behind one lock.</li>
<li>Nothing half-done: a refusal or a jam leaves stock, float and escrow exactly as they were.</li>
<li>In memory, one process, no persistence (say it; a follow-up adds it).</li></ul></div></div>
'''

PROMPT = ('"Design a vending machine. Several columns of products with prices and counts, coins in, the item '
          'and the change out, and a coin return button. I want working code, not a diagram. Go."')

PROBLEM_BODY = (
 '<div class="move"><div class="prompt">' + PROMPT + '</div></div>'
 '<div class="move"><h3>The problem, in plain words</h3><p>A box on a wall with a few columns of snacks. Each '
 'column has a code you press, one product and a count of how many are left. You push coins in one at a time; '
 'they sit inside the machine but they are still yours until something is sold. You press a code, and the '
 'machine either drops the item with your change, or tells you why it will not: no such code, that column is '
 'empty, you are short, or it cannot make your change from the coins it is holding. A coin return button gives '
 'you back exactly the coins you put in, right up to the moment the item falls. An operator refills the columns '
 'and the coin float. The one thing that must always be true is that money and stock stay in step: a unit leaves '
 'the machine only when it has been paid for, and every paise that went in comes back as change, as a refund, or '
 'stays as the machine\'s float.</p></div>'
 '<div class="move"><h3>What is expected of you in the hour</h3><p>Not a diagram: classes that compile and run, '
 'with a <code>main</code> that buys something and prints the change. The interviewer is watching for, in this '
 'order: the questions you ask before typing (money first or select first, and what happens when change is '
 'impossible, are the first two); which classes exist and which one owns the counts and which one owns the coins; '
 'a sale end to end; what happens when two panels press for the last unit; where the rules that will change '
 '(the price, the change algorithm) live, so a change is a new class and not an edit; and what the machine looks '
 'like after the motor jams with your money inside. Then the twists: cards, an exact-change lamp, holding an item, '
 'operator alerts, a bank of machines sharing stock.</p></div>'
 '<div class="move"><h3>What the code must do</h3></div>' + P_FLOWS +
 '<div class="move"><h3>Questions to ask back, and what each answer decides</h3></div>'
 '<div class="move"><table class="ask"><tr><th>Ask</th><th>Assume this when they say "you decide"</th><th>What the answer decides</th></tr>'
 '<tr><td>How many columns, and does each one carry its own price and count?</td><td>Several; yes, both</td><td>A Slot class and a map by code (moves 1, 5)</td></tr>'
 '<tr><td>Coins only, or card too? And does the machine give change?</td><td>Coins now, change yes, card later</td><td>A coin box with a float, and change behind an interface (move 3)</td></tr>'
 '<tr><td>Money first then select, or select then pay?</td><td>Money first; the coins sit in escrow</td><td>Two of the four modes, and what the coin return means (move 6)</td></tr>'
 '<tr><td>What happens when exact change cannot be made?</td><td>Refuse and refund everything</td><td>The change is proven before anything moves (move 6)</td></tr>'
 '<tr><td>One keypad, or can a card reader and a phone press at the same time?</td><td>Assume two can</td><td>One lock in the machine; the panel is a thin caller (moves 4, 7)</td></tr>'
 '<tr><td>Can the motor fail after the money is inside?</td><td>Yes, and the money must come back</td><td>The drop is the irreversible step; commit after it (moves 6, 9)</td></tr>'
 '<tr><td>Are operator actions in scope: restock, refill the float, alerts?</td><td>Yes, and one screen listens</td><td>An observer plus two operator methods (moves 3, 12)</td></tr>'
 '<tr><td>One machine in memory, or a bank of machines on a shared service?</td><td>One machine, one process</td><td>No repository yet; a follow-up adds one (move 12)</td></tr></table></div>'
 '<div class="move"><h3>What it must do, and what it must survive</h3></div>' + REQ_HTML +
 '<div class="move"><h3>One evening, replayed</h3></div>' + P_EX +
 '<div class="grade"><b>Say before typing:</b> money is integer paise, never a double; inserted coins sit in escrow '
 'and become the machine\'s only when a sale commits; the change is proven from float plus escrow before anything '
 'moves; the motor turning is the irreversible step, so stock goes down after it and never before; one machine, one '
 'lock, in memory, one process. Named as out of scope: cards and UPI, more than one currency, a bank of machines on '
 'a shared stock service, persistence &mdash; each is a follow-up on page 05.</div>')

# ============================================================ page 02: the twelve moves
MV = {}
# move 1: nouns with state -> classes
m1 = _D + '<rect x="20" y="20" width="1190" height="44" rx="6" fill="var(--bg3)" stroke="var(--line)"/>'
m1 += _tx(615, 47, "a CUSTOMER pushes COINS into a MACHINE; a SLOT holds a PRODUCT and a COUNT; the COIN BOX makes CHANGE; the TRAY holds what you take", "var(--text)", 12.5)
for k, (t, sub, acc) in enumerate([("Slot", "code, product, count", 1), ("CoinBox", "how many of each coin", 1),
                                   ("Tray", "what is waiting to be taken", 1), ("VendingMachine", "slots, float, escrow, lock", 1),
                                   ("Coin", "a fixed list of values: enum", 0), ("Front panel", "no state: a thin caller", 0)]):
    x = 20 + k*200
    m1 += _bx(x, 110, 185, 46, t, sub, acc=bool(acc), dash=not acc) + _ar("M%s 64 V110" % (x + 92))
m1 += _tx(615, 190, "solid = it has state of its own, so it becomes a class.   dashed = no state: a fixed list of values, or a caller", "var(--muted)", 11)
MV[1] = _mv(1230, 205, m1)

# move 2: verbs -> the class that owns the state they touch
m2 = _D
for k, (verb, cls, meth) in enumerate([("take a unit off the coil", "Slot  (owns the count)", "slot.takeOne()"),
                                       ("pay change out of the float", "CoinBox  (owns the coin counts)", "box.withdraw(coins)"),
                                       ("sell: press a slot", "VendingMachine  (owns both, plus the lock)", "machine.select(code)")]):
    y = 24 + k*56
    m2 += _bx(30, y, 330, 44, verb, "the verb") + _ar("M360 %s H430" % (y+22), True)
    m2 += _bx(430, y, 400, 44, cls, "the class whose state it touches", acc=True) + _ar("M830 %s H900" % (y+22), True)
    m2 += _bx(900, y, 300, 44, meth, "the method")
m2 += _tx(615, 213, "a verb whose state is spread over two classes goes to the class that owns both: that class becomes the orchestrator", "var(--muted)", 11)
m2 += _tx(615, 232, "\"sell\" touches the count, the float, the escrow and the tray, so it belongs to the machine and to nothing smaller", "var(--muted)", 11)
MV[2] = _mv(1230, 245, m2)

# move 3: rules that change -> one-method interfaces handed in
m3 = _D + _bx(30, 80, 220, 100, "VendingMachine", "configure(price, change, motor)", acc=True)
for k, (t, sub, impl) in enumerate([("PricingStrategy", "list price, happy hour, loyalty", "ListPrice / HappyHourDiscount"),
                                    ("ChangeStrategy", "greedy, back-off, a bounded DP", "GreedyChange / BackoffChange / DpChange"),
                                    ("Dispenser", "the motor; a test one that jams", "Motor / a jamming stub"),
                                    ("MachineObserver", "screen, restock pager, telemetry", "Display / RestockAlert / Telemetry")]):
    y = 20 + k*58
    m3 += _ar("M250 130 H330 V%s H400" % (y+22), True, True) + _bx(400, y, 300, 44, t, sub, dash=True)
    m3 += _bx(760, y, 440, 44, impl, "the classes that can be handed in") + _ar("M760 %s H700" % (y+22))
m3 += _tx(615, 275, "dashed lavender = handed in. The machine never builds a rule, so a new change algorithm is a new class and one changed line", "var(--muted)", 11)
m3 += _tx(615, 295, "and one price rule WRAPS another: new HappyHourDiscount(new ListPrice(), clock, 16, 18, 20). That wrapping is Decorator, born right here.", "var(--acc)", 11)
MV[3] = _mv(1230, 310, m3)

# move 4: the gap, and one owner with one lock
m4 = _D + _bx(30, 30, 210, 44, "keypad", "reads A1: 1 left") + _bx(30, 110, 210, 44, "card reader", "reads A1: 1 left")
m4 += _bx(360, 70, 190, 44, "slot A1", "count = 1", acc=True)
m4 += _ar("M240 52 H360 V70") + _ar("M240 132 H360 V114") + _tx(300, 40, "read", "var(--muted)", 10.5) + _tx(300, 160, "read", "var(--muted)", 10.5)
m4 += '<rect x="590" y="20" width="290" height="140" rx="6" fill="none" stroke="%s" stroke-dasharray="4 3"/>' % RED
m4 += _tx(735, 45, "the gap", RED, 12) + _tx(735, 70, "both saw 1, both take one:", RED, 11) + _tx(735, 90, "two items out, one paid for", RED, 11)
m4 += _tx(735, 130, "fix: read and write as ONE step", "var(--text)", 11)
m4 += _bx(910, 40, 290, 100, "VendingMachine.lock", "check, drop, commit = one step", acc=True)
m4 += _tx(1055, 165, "the lock lives where the shared state lives", "var(--muted)", 10.5)
m4 += _tx(1055, 185, "the screen is told AFTER the unlock, never inside", "var(--muted)", 10.5)
MV[4] = _mv(1230, 200, m4)

# move 5: each collection, its question, its O(1) shape
m5 = _D
for k, (q, shape, cost) in enumerate([("what is behind A1?", "Map&lt;code, Slot&gt;", "O(1)"),
                                      ("how many Rs 5 coins do we hold?", "EnumMap&lt;Coin, Integer&gt;  one array slot", "O(1)"),
                                      ("what is the whole float worth?", "sum over 5 denominations", "O(5)"),
                                      ("is this button legal right now?", "EnumMap&lt;State, EnumSet&lt;Action&gt;&gt;", "O(1)"),
                                      ("what has this customer put in?", "List&lt;Coin&gt; escrow, appended", "O(1) add")]):
    y = 16 + k*46
    m5 += _bx(30, y, 360, 38, q, "the question") + _ar("M390 %s H450" % (y+19), True)
    m5 += _bx(450, y, 520, 38, shape, "the shape", acc=True) + _ar("M970 %s H1030" % (y+19), True) + _bx(1030, y, 170, 38, cost, "")
m5 += _tx(615, 268, "the escrow is a LIST of coins, not a total, because the coin return owes you the same coins back, not the same amount", "var(--muted)", 11)
MV[5] = _mv(1230, 282, m5)

# move 6: the state machine and the ORDER at the critical step
m6 = _D + _bx(30, 30, 165, 44, "IDLE", "insert coin", acc=True)
m6 += _bx(225, 30, 165, 44, "HAS_MONEY", "escrow > 0", acc=True) + _bx(420, 30, 165, 44, "DISPENSING", "the flap is open", acc=True)
m6 += _ar("M195 52 H225", True) + _ar("M390 52 H420", True)
m6 += _bx(30, 120, 165, 44, "OUT_OF_SERVICE", "cancel still works") + _ar("M60 74 V120")
m6 += _ar("M502 74 V100 H160 V74", True) + _tx(345, 114, "commit, or refund", "var(--acc)", 10.5)
m6 += '<rect x="620" y="20" width="590" height="190" rx="6" fill="var(--bg3)" stroke="var(--line)"/>' + _tx(915, 44, "the order inside select(), and why it is this order", "var(--text)", 12)
for k, l in enumerate(["1 three refusals that touch nothing: no such code, sold out, too little money",
                       "2 prove the change from float + escrow -- a PURE plan; the float is not touched",
                       "3 turn the motor: the one act that cannot be taken back",
                       "4 only now: count -1, escrow into the float, change out, both into the tray",
                       "a refusal or a jam leaves stock, float and escrow exactly as they were;",
                       "the money is never kept for an item that did not fall"]):
    m6 += _tx(635, 68 + k*24, l, "var(--muted)" if k > 3 else "var(--text)", 11, "start")
m6 += _tx(615, 235, "an illegal action THROWS (a coin pushed in while the flap is open); a refused sale RETURNS a reason (sold out, too little, no change). Different things.", "var(--muted)", 11)
MV[6] = _mv(1230, 250, m6)

# move 7: what is inside the lock, and eight panels at the same instant
m7 = _D + _card(30, 20, 540, 150, "inside the lock",
                ["one map lookup for the slot: ~0.1 us", "the price rule: one call, ~0.1 us",
                 "the change plan over 5 denominations: ~1 us", "about ten EnumMap and list writes: ~0.3 us",
                 "and the MOTOR: about 2 SECONDS", "that last line is the whole problem"], acc=True)
m7 += _ar("M570 95 H640", True) + _tx(605, 85, "unlock", "var(--acc)", 10.5)
m7 += _card(640, 20, 560, 150, "outside the lock",
            ["the screen and the pager: after the unlock", "telemetry and the operator dashboard: after too",
             "the customer choosing and fishing for coins: seconds", "a broken listener cannot stall a sale",
             "rung one of the ladder moves the motor out here"])
m7 += _tx(615, 200, "eight panels press in the same second", "var(--text)", 12)
for k in range(8):
    x = 30 + k*148
    m7 += _bx(x, 214, 136, 40, "panel %d" % (k+1), "waits %d s" % (k*2), acc=(k == 7))
m7 += _tx(615, 282, "unlike most designs, here the queue is VISIBLE: the eighth panel waits fourteen seconds, because a two-second motor runs inside the lock.", "var(--muted)", 11)
m7 += _tx(615, 300, "one machine has one or two panels, so today nobody notices; a bank of machines on one stock service would, which is what the ladder is for.", "var(--muted)", 11)
MV[7] = _mv(1230, 314, m7)

# move 8: the arithmetic, then the ladder
m8 = _D + '<rect x="20" y="20" width="560" height="185" rx="6" fill="var(--bg3)" stroke="var(--line)"/>' + _tx(300, 42, "one lock per machine: is it a bottleneck? do the arithmetic", "var(--text)", 12)
for k, l in enumerate(["everything except the motor: ~1.5 us of lock per sale",
                       "a busy station machine: 300 sales a day, one every 5 minutes",
                       "the motor at 2 s x 300 = 600 s of lock in 86,400 s: 0.7% busy",
                       "two presses inside the same 2 s window: a handful at the evening peak",
                       "the weak spot is not the lock, it is the 2 seconds inside it"]):
    m8 += _tx(35, 66 + k*24, l, RED if k == 4 else "var(--muted)", 11, "start")
m8 += _tx(890, 42, "the upgrade ladder, in the order you would climb it", "var(--text)", 12)
for k, (t, sub) in enumerate([("1 the motor outside the lock", "reserve the unit, drop, then commit or put it back"),
                              ("2 a lock per column", "two panels on different columns never wait"),
                              ("3 the count itself decides", "compareAndSet, or UPDATE slot SET qty=qty-1 WHERE qty&gt;0")]):
    m8 += _bx(600, 58 + k*50, 600, 42, t, sub, acc=(k == 0))
MV[8] = _mv(1230, 220, m8)

# move 9: what can go wrong, and the test for each
m9 = _D
for k, (bad, fix) in enumerate([("two panels press for the last unit", "one lock round the whole sale; test 1: 40 threads, one item out, the float grew by one price"),
                                ("the float cannot make Rs 15", "prove the change before anything moves; test 2: full refund, stock and float untouched"),
                                ("the motor jams with the money inside", "commit only after the item falls; test 4: Rs 30 back, no unit lost"),
                                ("a coin pushed in while the flap is open", "the ALLOWED table refuses it; test 7: it throws, and so does a second press"),
                                ("the screen throws", "publish after the unlock in a try/catch; test 6: the sale still completes"),
                                ("happy hour, tested at midnight in CI", "the clock is handed in; test 8: Rs 25 at 10:00, Rs 20 at 16:30")]):
    y = 18 + k*42
    m9 += _bx(30, y, 320, 38, bad, "") + _ar("M350 %s H400" % (y+19), True) + _bx(400, y, 800, 38, fix, "", acc=True)
m9 += _tx(615, 292, "every claim this design makes has a failure test: FailureTests.java runs eight of them and must print ALL PASS", "var(--muted)", 11)
MV[9] = _mv(1230, 305, m9)

# move 10: the patterns, named after the fact
cols10 = [("pattern", 12), ("born in", 210), ("the line in the code", 300), ("what it buys", 850)]
rows10 = [[("Strategy", "var(--text)"), ("move 3", None), ("interface ChangeStrategy { List&lt;Coin&gt; plan(available, amount); }", None), ("a new change algorithm is a class, not an edit", None)],
          [("Decorator", "var(--text)"), ("move 3", None), ("new HappyHourDiscount(new ListPrice(), clock, 16, 18, 20)", None), ("add to a price rule instead of copying it", None)],
          [("Observer", "var(--text)"), ("move 4", None), ("publish(event) after the unlock, inside a try/catch", None), ("the screen hears; the sale never waits", None)],
          [("State", "var(--text)"), ("move 6", None), ("ALLOWED: EnumMap&lt;MachineState, EnumSet&lt;Action&gt;&gt;", None), ("an illegal button cannot do anything", None)],
          [("Null-safe seam", "var(--text)"), ("move 3", None), ("Dispenser handed in: the real motor, or one that jams", None), ("the physical failure is testable in one line", None)],
          [("Singleton", "var(--muted)"), ("not here", None), ("panels are HANDED the machine; nothing calls getInstance()", "var(--muted)"), ("every test builds a fresh machine", "var(--muted)")],
          [("Factory", "var(--muted)"), ("not yet", None), ("SlotFactory.fromConfig(\"A1|LAY|Lays|2000|8|3\") once columns come from a file", "var(--muted)"), ("today the columns arrive already typed", "var(--muted)")],
          [("Builder", "var(--muted)"), ("never", None), ("a slot has four fields and every one is required", "var(--muted)"), ("a pattern without a move is decoration", "var(--muted)")]]
m10 = _D + _table(20, 20, cols10, rows10, rowh=30, widths=1190)
m10 += _tx(615, 305, "name a pattern only after the move that produced it; then every name has a one-sentence defence", "var(--muted)", 11)
MV[10] = _mv(1230, 320, m10)

# move 11: SOLID as a check on the moves
cols11 = [("", 12), ("the rule, in plain words", 50), ("from", 440), ("the line that shows it", 560)]
rows11 = [[("S", "var(--acc)"), ("one reason to change per class", None), ("move 2", None), ("Slot: its count. CoinBox: the coins. The machine: the flow and the lock.", None)],
          [("O", "var(--acc)"), ("new behaviour is a new class, not an edited one", None), ("move 3", None), ("DpChange is a new file plus one line in configure()", None)],
          [("L", "var(--acc)"), ("any implementation drops in; nobody checks which", None), ("move 3", None), ("changeRule.plan(pool, due);  never \"is this the greedy one?\"", None)],
          [("I", "var(--acc)"), ("small interfaces: one method each", None), ("move 3", None), ("PricingStrategy, ChangeStrategy, Dispenser, MachineObserver, Clock: one method each", None)],
          [("D", "var(--acc)"), ("depend on interfaces; implementations are handed in", None), ("moves 3, 9", None), ("vm.configure(new HappyHourDiscount(...), new BackoffChange(), new Motor())", None)]]
m11 = _D + _table(20, 20, cols11, rows11, rowh=34, widths=1190)
m11 += _tx(615, 250, "SOLID is not a list to recite; it is the check that the moves did their job, one line each", "var(--muted)", 11)
MV[11] = _mv(1230, 265, m11)

# move 12: every twist is one of five moves
m12 = _D
for k, (t, sub, fix, sub2, mv) in enumerate([
        ("a new rule", "a bounded-DP change maker, loyalty pricing", "a new class behind the existing interface plus one configure line", "", "move 3"),
        ("someone new wants to know", "telemetry, a low-cash pager, a planogram service", "one more observer; the sale path does not change at all", "", "move 4"),
        ("a new step in a life", "out of service, reserved, refunding", "one more row in the ALLOWED table (a class once the mode grows behaviour)", "", "move 6"),
        ("a new invariant across items", "a combo: two columns, both or neither", "both claims inside the SAME lock: all or nothing", "", "move 4"),
        ("state that must outlive the process", "a power cut; a bank of machines sharing stock", "the counts and the float behind a repository; the decrement becomes", "UPDATE slot SET qty = qty - 1 WHERE code = ? AND qty &gt; 0  -- 0 rows means another terminal got it", "moves 5 + 12")]):
    y = 24 + k*54
    m12 += _bx(30, y, 330, 44, t, sub) + _ar("M360 %s H420" % (y+22), True) + _bx(420, y, 660, 44, fix, sub2, acc=True) + _tx(1150, y+27, mv, "var(--muted)", 11)
m12 += _tx(615, 312, "for all five the slot, the coin box and the tests do not change; that is the test that the derivation was right", "var(--muted)", 11)
MV[12] = _mv(1230, 325, m12)

MOVES = [
("Move 1: underline the nouns. Every noun with its own state becomes a class.",
 "Reading the paragraph again: a <b>customer</b> pushes <b>coins</b> into a <b>machine</b>; a <b>slot</b> holds a "
 "<b>product</b> and a <b>count</b>; the <b>coin box</b> makes <b>change</b>; the item and the change land in a "
 "<b>tray</b>. A slot has a code, a product and a count, so it is a class. The coin box has how many of each coin it "
 "holds: a class. The tray has whatever is waiting to be picked up: a class. The machine holds all of those plus the "
 "coins this customer has pushed in so far: a class, and the only one with a lock. A coin is a fixed list of values "
 "with a price in paise, so it is an enum, not a class. A product is a catalogue entry the slot points at. The front "
 "panel remembers nothing, so it is a thin caller, which is exactly why adding a second panel changes no design.", 1),
("Move 2: for every verb, ask which class holds the state it touches. That class gets the method.",
 "\"Take a unit off the coil\" changes the slot's count, so <code>slot.takeOne()</code>. \"Pay change out of the "
 "float\" changes the coin box's counts, so <code>box.withdraw(coins)</code>. \"Sell\" touches the count, the float, "
 "the escrow and the tray at once, and only the machine sees all four, so <code>machine.select(code)</code>. When a "
 "verb's state is spread over several classes it goes to the class that owns them all, and that class becomes the "
 "orchestrator. That is how small dumb models and one busy machine appear without planning them. Note what did not "
 "become a verb: \"make change\" touches nothing at all, which is why it can be a pure function and a swappable rule.", 2),
("Move 3: every rule the interviewer can change mid-round goes behind an interface and is handed in.",
 "The price will change (list price today, happy hour on Friday). How change is made will change (greedy today; a "
 "lopsided float or odd denominations tomorrow). The motor is a physical thing a test has to be able to jam. And "
 "somebody will want to be told when a column empties. Each becomes a one-method interface the machine is "
 "<i>given</i> in <code>configure()</code>, never builds itself. This is where the patterns come from, not the other "
 "way round: a swappable rule behind an interface is <b>Strategy</b>; a rule that wraps another rather than replacing "
 "it &mdash; <code>new HappyHourDiscount(new ListPrice(), clock, 16, 18, 20)</code> &mdash; is <b>Decorator</b>; a "
 "machine that announces \"A1 is empty\" without knowing whether anyone is listening is <b>Observer</b>. Do them; do "
 "not announce them.", 3),
("Move 4: state that many callers change at the same time gets one owner and one lock.",
 "A modern machine has a keypad, a card reader and a phone app, and all three can press for the last packet of Lays "
 "in the same instant. Between \"I read that A1 has one left\" and \"I took it\" another caller can take it; that gap "
 "is where two items leave and one is paid for. So the check, the drop and the commit must be one step under one "
 "lock, in the class that owns the counts, the float and the escrow: the machine. And anything that only listens "
 "&mdash; the screen, the restock pager, the telemetry sink &mdash; is called after the lock is released, inside a "
 "try/catch, so a dead screen cannot stall a sale.", 4),
("Move 5: for each collection, ask what question is asked of it, and pick the shape that answers in O(1).",
 "\"What is behind A1?\": a map from code to slot. \"How many five-rupee coins do we hold?\": an <code>EnumMap</code> "
 "from coin to count, which is an array index, not a hash. \"Is this button legal right now?\": a table from mode to "
 "the set of allowed actions, so legality is a lookup and not an if-chain. \"What has this customer put in?\": a "
 "<i>list</i> of coins, not a total &mdash; the coin return owes you the same coins back, not the same amount, and a "
 "total cannot tell you which coins those were. Every scan avoided here is a question not fumbled in the concurrency "
 "round, because the scan would have been inside the lock.", 5),
("Move 6: anything with a life cycle is a state machine, and the order of operations is part of the design.",
 "The machine is IDLE until a coin drops, HAS_MONEY while the escrow is not empty, DISPENSING while the flap is open, "
 "and OUT_OF_SERVICE when an operator takes it away &mdash; and even then the coin return works, because you never "
 "strand somebody who already paid. Writing the modes down forces the question the interviewer will ask: what if the "
 "motor jams with my money inside? The answer is an order. Refuse for free first (no such code, sold out, too little "
 "money) without touching a paise. Then prove the change from float plus escrow with a pure function that mutates "
 "nothing. Then turn the motor, the one act that cannot be taken back. Only when the item has fallen does anything "
 "commit: count down one, escrow into the float, change out of the float, both into the tray. One more distinction "
 "worth saying aloud: an illegal action throws, because it is a bug or a broken panel, while a refused sale returns a "
 "reason, because it is a normal Tuesday.", 6),
("Move 7: yes, the lock makes sales happen one at a time. Ask for how long, and what is inside it.",
 "Inside the lock there is a map lookup, one call to the price rule, a change plan over five denominations and about "
 "ten small writes: something like one and a half microseconds. Then there is the motor, which takes about two "
 "seconds, and it is inside the lock too. That is unusual and worth saying out loud: in most designs the lock is "
 "invisible, and here it is not. If eight panels pressed in the same second the eighth would wait fourteen seconds. "
 "A real machine has one keypad and maybe a card reader, so nobody notices &mdash; but the moment you put a bank of "
 "machines behind one stock service, this is the first thing that breaks, which is why the next move's ladder starts "
 "by getting the motor out of the critical section.", 7),
("Move 8: say the arithmetic, then name the ladder.",
 "A busy station machine sells about three hundred items a day, one every five minutes. Everything except the motor "
 "is one and a half microseconds of lock per sale, which is nothing. The motor is two seconds, so the lock is held "
 "for six hundred seconds out of eighty-six thousand four hundred: busy 0.7% of the day, and two presses inside the "
 "same two-second window happen a handful of times at the evening peak. Then the ladder, in the order you would climb "
 "it: take the motor out of the lock by reserving the unit in a very short section, dropping with the lock released, "
 "and committing or putting the reservation back in a second short section; then a lock per column, so two panels on "
 "different columns never wait; then let the count itself decide the winner with a compare-and-set, which for a shared "
 "stock service is the same thing as <code>UPDATE slot SET qty = qty - 1 WHERE qty &gt; 0</code>. Say the arithmetic "
 "first: climbing the ladder without it is complexity nobody asked for.", 8),
("Move 9: list what can go wrong, and write the test for each before the interview is over.",
 "Two panels press for the last unit (exactly one item leaves). The float cannot make fifteen rupees (refuse and "
 "refund; stock and float identical afterwards). The motor jams with thirty rupees inside (the money comes back, no "
 "unit is lost). A coin is pushed in while the flap is open (refused loudly). The screen throws (the sale still "
 "completes). Happy hour has to be tested at midnight in CI (time is handed in, so the test picks 16:30). Each of "
 "these is a few lines in FailureTests.java, and the race one is the interesting test: forty threads on one latch, "
 "one item out, thirty-nine full refunds, and the float grown by exactly one price &mdash; which proves the money "
 "invariant and the stock invariant in the same assertion.", 9),
("Move 10: now, and only now, name the patterns. Each one is the result of a move.",
 "Every pattern here came out of a move, which is why each can be defended in one sentence: rules that will change "
 "went behind one-method interfaces (Strategy: price, change, motor); a price rule that wraps another instead of "
 "replacing it is Decorator (happy hour over list price); the machine announces \"A1 is empty\" to whoever "
 "subscribed and never learns what a screen is (Observer); the modes and the actions they allow are a table, checked "
 "before every action (State). Singleton did not earn a place: panels are handed the machine, so every test builds a "
 "fresh one. Factory did not either &mdash; the columns arrive already typed &mdash; and it earns one the moment "
 "columns come from a planogram file as strings, which is the <code>SlotFactory</code> in Extensions.java. When asked "
 "\"where would you use Builder?\", the right answer is \"nowhere: a slot has four fields and all four are required\". "
 "A pattern without a move behind it is decoration.", 10),
("Move 11: run SOLID as a check on the moves, one line each.",
 "S: each class has one reason to change, which move 2 gave you &mdash; a slot changes when its count does, the coin "
 "box when the coins do, the tray when something is waiting, the machine when the flow does. O: a new behaviour is a "
 "new class and one changed line, never an opened one (<code>DpChange</code> is a file plus a line in "
 "<code>configure()</code>). L: any implementation drops in and nothing asks which one it got (the machine calls "
 "<code>changeRule.plan(pool, due)</code>, never \"is this the greedy one?\"). I: the interfaces have one method each, "
 "so a fake for a test is a lambda &mdash; <code>code -&gt; false</code> is a jammed motor. D: the machine depends on "
 "interfaces it is handed, which is exactly why a test can give it a clock that says 16:30 and a motor that never "
 "turns.", 11),
("Move 12: every twist the interviewer adds is one of five moves. Say which before you type.",
 "A new rule (a bounded-DP change maker for odd denominations, loyalty pricing) is a new class behind an existing "
 "interface plus one configure line. Someone new who wants to know (telemetry, a low-cash pager, a planogram service) "
 "is one more observer, and the sale path does not change at all. A new step in a life (out of service, reserved, "
 "refunding) is one more row in the allowed table &mdash; and when a mode grows behaviour of its own, that row is "
 "promoted to a class, which is the <code>MaintenanceMode</code> in Extensions.java. A new invariant across items (a "
 "combo deal: two columns, both or neither) is both claims inside the same lock, all or nothing. State that must "
 "outlive the process (a power cut, or a bank of machines sharing stock) is the counts and the float behind a "
 "repository interface, and the decrement becomes a conditional update where the count is still positive: the "
 "database's compare-and-set, the same idea as the lock, one atomic step deciding the winner. For all five the slot, "
 "the coin box and the tests do not change; that is the test that the derivation was right. Page 05 has the code for "
 "each.", 12),
]

